      "file_change",
      "mcp",
      "web",
      "tool"
    ]
  },
  "configuration": {
    "ephemeral": true,
    "strict": true,
    "user_config": "ignored",
    "rules": "ignored",
    "sandbox": "read_only",
    "approval_policy": "never",
    "web_search": "disabled"
  },
  "environment": {
    "inherited": false,
    "codex_home": "dedicated_minimal",
    "codex_home_contents": [
      "opaque_saved_login_prerequisite"
    ],
    "scratch": "empty_private",
    "ambient_home_mounted": false,
    "vault_mounted": false
  }
