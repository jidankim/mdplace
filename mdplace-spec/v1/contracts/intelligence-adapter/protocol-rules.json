{
  "$schema": "../schemas/intelligence-adapter-protocol-rules.schema.json",
  "schema_id": "mdplace.intelligence-adapter-protocol-rules/v1",
  "decision": "https://github.com/jidankim/mdplace/issues/8#issuecomment-5100984093",
  "outcome_precedence": [
    {"order": 1, "condition": "policy inactive stale or mismatched", "code": "adapter.policy_binding_denied", "outcome": "denied"},
    {"order": 2, "condition": "Source Profile inactive stale or mismatched", "code": "adapter.source_profile_binding_denied", "outcome": "denied"},
    {"order": 3, "condition": "provider not exactly approved", "code": "adapter.provider_denied", "outcome": "denied"},
    {"order": 4, "condition": "purpose not exactly approved", "code": "adapter.purpose_denied", "outcome": "denied"},
    {"order": 5, "condition": "destination or endpoint not exactly approved", "code": "adapter.destination_denied", "outcome": "denied"},
    {"order": 6, "condition": "transmitted field not approved", "code": "adapter.field_denied", "outcome": "denied"},
    {"order": 7, "condition": "retained artifact not approved", "code": "adapter.artifact_denied", "outcome": "denied"},
    {"order": 8, "condition": "redaction receipt missing or mismatched", "code": "adapter.redaction_unproven", "outcome": "denied"},
    {"order": 9, "condition": "retention fact missing or mismatched", "code": "adapter.retention_unproven", "outcome": "denied"},
    {"order": 10, "condition": "capability not approved", "code": "adapter.capability_denied", "outcome": "denied"},
    {"order": 11, "condition": "credential boundary mismatched", "code": "adapter.credential_boundary_denied", "outcome": "denied"},
    {"order": 12, "condition": "input bytes exceed attempt or chain ceiling", "code": "adapter.input_budget_exhausted", "outcome": "budget_exhausted"},
    {"order": 13, "condition": "isolation precondition failed", "code": "adapter.isolation_failed", "outcome": "isolation_failure"},
    {"order": 14, "condition": "canary failed", "code": "adapter.canary_failed", "outcome": "isolation_failure"},
    {"order": 15, "condition": "adapter attempted tool invocation", "code": "adapter.tool_request_denied", "outcome": "denied"},
    {"order": 16, "condition": "adapter requested a secret", "code": "adapter.secret_request_denied", "outcome": "denied"},
    {"order": 17, "condition": "adapter requested ambient configuration", "code": "adapter.ambient_config_denied", "outcome": "denied"},
    {"order": 18, "condition": "adapter requested filesystem mutation", "code": "adapter.filesystem_authority_denied", "outcome": "denied"},
    {"order": 19, "condition": "adapter requested semantic truth mutation", "code": "adapter.semantic_authority_denied", "outcome": "denied"},
    {"order": 20, "condition": "adapter requested note placement", "code": "adapter.placement_authority_denied", "outcome": "denied"},
    {"order": 21, "condition": "adapter reports timeout or runtime exceeds an attempt or chain ceiling", "code": "adapter.timeout", "outcome": "timeout"},
    {"order": 22, "condition": "output bytes exceed attempt or chain ceiling", "code": "adapter.output_budget_exhausted", "outcome": "budget_exhausted"},
    {"order": 23, "condition": "cost exceeds attempt or chain ceiling", "code": "adapter.cost_budget_exhausted", "outcome": "budget_exhausted"},
    {"order": 24, "condition": "output is malformed partial or schema-invalid", "code": "adapter.malformed_output", "outcome": "malformed_output"},
    {"order": 25, "condition": "proposal binding or evidence reference mismatched", "code": "adapter.proposal_binding_denied", "outcome": "denied"},
    {"order": 26, "condition": "cached proposal binding stale", "code": "adapter.cached_proposal_stale", "outcome": "denied"},
    {"order": 27, "condition": "authorized retry unavailable or exhausted", "code": "adapter.retry_exhausted", "outcome": "retry_exhausted"},
    {"order": 28, "condition": "fallback unavailable forbidden or exhausted", "code": "adapter.fallback_exhausted", "outcome": "fallback_exhausted"},
    {"order": 29, "condition": "crash completion cannot be proven", "code": "adapter.recovery_unknown_completion", "outcome": "recovery_required"}
  ],
  "receipt_reasons": [
    {"code": "adapter.policy_binding_denied", "outcome": "denied"},
    {"code": "adapter.source_profile_binding_denied", "outcome": "denied"},
    {"code": "adapter.provider_denied", "outcome": "denied"},
    {"code": "adapter.purpose_denied", "outcome": "denied"},
    {"code": "adapter.destination_denied", "outcome": "denied"},
    {"code": "adapter.field_denied", "outcome": "denied"},
    {"code": "adapter.artifact_denied", "outcome": "denied"},
    {"code": "adapter.redaction_unproven", "outcome": "denied"},
    {"code": "adapter.retention_unproven", "outcome": "denied"},
    {"code": "adapter.capability_denied", "outcome": "denied"},
    {"code": "adapter.credential_boundary_denied", "outcome": "denied"},
    {"code": "adapter.input_budget_exhausted", "outcome": "budget_exhausted"},
    {"code": "adapter.isolation_failed", "outcome": "isolation_failure"},
    {"code": "adapter.canary_failed", "outcome": "isolation_failure"},
    {"code": "adapter.tool_request_denied", "outcome": "denied"},
    {"code": "adapter.secret_request_denied", "outcome": "denied"},
    {"code": "adapter.ambient_config_denied", "outcome": "denied"},
    {"code": "adapter.filesystem_authority_denied", "outcome": "denied"},
    {"code": "adapter.semantic_authority_denied", "outcome": "denied"},
    {"code": "adapter.placement_authority_denied", "outcome": "denied"},
    {"code": "adapter.timeout", "outcome": "timeout"},
    {"code": "adapter.output_budget_exhausted", "outcome": "budget_exhausted"},
    {"code": "adapter.cost_budget_exhausted", "outcome": "budget_exhausted"},
    {"code": "adapter.malformed_output", "outcome": "malformed_output"},
    {"code": "adapter.proposal_binding_denied", "outcome": "denied"},
    {"code": "adapter.cached_proposal_stale", "outcome": "denied"},
    {"code": "adapter.retry_scheduled", "outcome": "retry_scheduled"},
    {"code": "adapter.retry_exhausted", "outcome": "retry_exhausted"},
    {"code": "adapter.fallback_scheduled", "outcome": "fallback_scheduled"},
    {"code": "adapter.fallback_exhausted", "outcome": "fallback_exhausted"},
    {"code": "adapter.recovery_unknown_completion", "outcome": "recovery_required"},
    {"code": "adapter.recovery_before_transmission_denied", "outcome": "denied"},
    {"code": "adapter.illegal_transition", "outcome": "denied"},
    {"code": "adapter.proposal_accepted_as_advice", "outcome": "accepted"}
  ],
  "forbidden_actions": ["invoke_tool", "request_secret", "read_ambient_config", "write_file", "establish_semantic_truth", "choose_note_placement"],
  "lifecycle_tables": [
    "contracts/transitions/intelligence-adapter-execution-lifecycle.json",
    "contracts/transitions/intelligence-adapter-denial-lifecycle.json",
    "contracts/transitions/intelligence-adapter-timeout-lifecycle.json",
    "contracts/transitions/intelligence-adapter-retry-lifecycle.json",
    "contracts/transitions/intelligence-adapter-fallback-lifecycle.json",
    "contracts/transitions/intelligence-adapter-isolation-lifecycle.json",
    "contracts/transitions/intelligence-adapter-recovery-lifecycle.json"
  ]
}
