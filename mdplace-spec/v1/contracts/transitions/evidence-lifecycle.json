{
  "$schema": "../schemas/transition-table.schema.json",
  "schema_id": "mdplace.transition-table/v1",
  "table_id": "TRANS-VALIDATOR-EVIDENCE",
  "lifecycle": "Evidence Envelope and Claim Manifest readback",
  "version": "1.0.0",
  "states": ["awaiting_evidence", "verdict_recorded", "evidence_stale"],
  "commands": ["record_verdict", "readback", "mark_stale", "supply_fresh_evidence"],
  "transitions": [
    {
      "transition_id": "TR-VAL-001",
      "command_or_event": "record_verdict",
      "from_state": "awaiting_evidence",
      "allowed": true,
      "actor_authority": {"roles": ["conformance_validator"], "quorum": 1, "distinct_actors": false, "delegation": "forbidden"},
      "preconditions": ["fresh required evidence is supplied", "a digest-bound fresh-supply Recovery Report observes awaiting_evidence", "all bindings recompute", "aggregate verdict is explicit"],
      "base_references": ["package_series", "release_version", "validator_version", "fresh_claim_digest", "fresh_invocation_digest", "recovery_report_digest"],
      "emitted_records": ["EvidenceEnvelope", "ClaimManifest", "EvidenceValidationReceipt"],
      "filesystem_effects": ["write digest-bound evidence artifacts"],
      "idempotency": {"key_fields": ["invocation_id", "evidence_digest"], "retry_result": "return the recorded verdict and receipts"},
      "terminal_state": "verdict_recorded",
      "failure_result": {"code": "evidence.binding_invalid", "state_effect": "unchanged", "emitted_records": ["EvidenceTransitionDenied"], "filesystem_effects": ["none"]},
      "recovery": "Correct the declared binding or supply fresh evidence before retrying."
    },
    {
      "transition_id": "TR-VAL-002",
      "command_or_event": "readback",
      "from_state": "awaiting_evidence",
      "allowed": false,
      "actor_authority": {"roles": ["conformance_validator"], "quorum": 1, "distinct_actors": false, "delegation": "forbidden"},
      "preconditions": ["a recorded verdict exists"],
      "base_references": ["claim_id"],
      "emitted_records": ["EvidenceTransitionDenied"],
      "filesystem_effects": ["none"],
      "idempotency": {"key_fields": ["claim_id", "command"], "retry_result": "return the original denial"},
      "terminal_state": "awaiting_evidence",
      "failure_result": {"code": "evidence.verdict_absent", "state_effect": "unchanged", "emitted_records": ["EvidenceTransitionDenied"], "filesystem_effects": ["none"]},
      "recovery": "Record a verdict from fresh required evidence before readback."
    },
    {
      "transition_id": "TR-VAL-003",
      "command_or_event": "mark_stale",
      "from_state": "awaiting_evidence",
      "allowed": false,
      "actor_authority": {"roles": ["conformance_validator"], "quorum": 1, "distinct_actors": false, "delegation": "forbidden"},
      "preconditions": ["a recorded evidence binding exists"],
      "base_references": ["claim_id"],
      "emitted_records": ["EvidenceTransitionDenied"],
      "filesystem_effects": ["none"],
      "idempotency": {"key_fields": ["claim_id", "command"], "retry_result": "return the original denial"},
      "terminal_state": "awaiting_evidence",
      "failure_result": {"code": "evidence.binding_absent", "state_effect": "unchanged", "emitted_records": ["EvidenceTransitionDenied"], "filesystem_effects": ["none"]},
      "recovery": "Record evidence before a binding can become stale."
    },
    {
      "transition_id": "TR-VAL-004",
      "command_or_event": "supply_fresh_evidence",
      "from_state": "awaiting_evidence",
      "allowed": true,
      "actor_authority": {"roles": ["evidence_supplier"], "quorum": 1, "distinct_actors": false, "delegation": "permitted"},
      "preconditions": ["new required evidence is explicitly declared"],
      "base_references": ["claim_id", "fresh_claim_digest", "fresh_invocation_digest"],
      "emitted_records": ["FreshEvidenceSupplied"],
      "filesystem_effects": ["stage declared evidence only"],
      "idempotency": {"key_fields": ["claim_id", "input_digest"], "retry_result": "return the original supply receipt"},
      "terminal_state": "awaiting_evidence",
      "failure_result": {"code": "evidence.fresh_input_invalid", "state_effect": "unchanged", "emitted_records": ["EvidenceTransitionDenied"], "filesystem_effects": ["none"]},
      "recovery": "Correct the fresh evidence binding and retry."
    },
    {
      "transition_id": "TR-VAL-005",
      "command_or_event": "record_verdict",
      "from_state": "verdict_recorded",
      "allowed": false,
      "actor_authority": {"roles": ["conformance_validator"], "quorum": 1, "distinct_actors": false, "delegation": "forbidden"},
      "preconditions": ["state is awaiting_evidence"],
      "base_references": ["claim_id", "recorded_evidence_digest"],
      "emitted_records": ["EvidenceTransitionDenied"],
      "filesystem_effects": ["none"],
      "idempotency": {"key_fields": ["claim_id", "command"], "retry_result": "return the original denial"},
      "terminal_state": "verdict_recorded",
      "failure_result": {"code": "evidence.fresh_input_required", "state_effect": "unchanged", "emitted_records": ["EvidenceTransitionDenied"], "filesystem_effects": ["none"]},
      "recovery": "Supply fresh required evidence before recording another verdict."
    },
    {
      "transition_id": "TR-VAL-006",
      "command_or_event": "readback",
      "from_state": "verdict_recorded",
      "allowed": true,
      "actor_authority": {"roles": ["conformance_validator"], "quorum": 1, "distinct_actors": false, "delegation": "forbidden"},
      "preconditions": ["all declared paths reopen safely", "all bindings are recomputed"],
      "base_references": ["claim_id", "recorded_evidence_digest", "recovery_report_digest"],
      "emitted_records": ["EvidenceRecoveryReport"],
      "filesystem_effects": ["none"],
      "idempotency": {"key_fields": ["claim_id", "recorded_evidence_digest"], "retry_result": "reproduce the same report"},
      "terminal_state": "verdict_recorded",
      "failure_result": {"code": "evidence.readback_invalid", "state_effect": "unchanged", "emitted_records": ["EvidenceRecoveryReport"], "filesystem_effects": ["none"]},
      "recovery": "Mark a mismatched binding stale; otherwise preserve the recorded verdict."
    },
    {
      "transition_id": "TR-VAL-007",
      "command_or_event": "mark_stale",
      "from_state": "verdict_recorded",
      "allowed": true,
      "actor_authority": {"roles": ["conformance_validator"], "quorum": 1, "distinct_actors": false, "delegation": "forbidden"},
      "preconditions": ["readback found a version or digest mismatch"],
      "base_references": ["claim_id", "recorded_evidence_digest", "observed_evidence_digest", "recovery_report_digest"],
      "emitted_records": ["EvidenceMarkedStale", "EvidenceRecoveryReport"],
      "filesystem_effects": ["none"],
      "idempotency": {"key_fields": ["claim_id", "observed_evidence_digest"], "retry_result": "return the stale report"},
      "terminal_state": "evidence_stale",
      "failure_result": {"code": "evidence.staleness_unproven", "state_effect": "unchanged", "emitted_records": ["EvidenceTransitionDenied"], "filesystem_effects": ["none"]},
      "recovery": "Recompute bindings or supply fresh required evidence."
    },
    {
      "transition_id": "TR-VAL-008",
      "command_or_event": "supply_fresh_evidence",
      "from_state": "verdict_recorded",
      "allowed": true,
      "actor_authority": {"roles": ["evidence_supplier"], "quorum": 1, "distinct_actors": false, "delegation": "permitted"},
      "preconditions": ["new required evidence is explicitly declared"],
      "base_references": ["claim_id", "recorded_claim_digest", "fresh_claim_digest", "fresh_invocation_digest"],
      "emitted_records": ["FreshEvidenceSupplied"],
      "filesystem_effects": ["stage declared evidence only"],
      "idempotency": {"key_fields": ["claim_id", "input_digest"], "retry_result": "return the original supply receipt"},
      "terminal_state": "awaiting_evidence",
      "failure_result": {"code": "evidence.fresh_input_invalid", "state_effect": "unchanged", "emitted_records": ["EvidenceTransitionDenied"], "filesystem_effects": ["none"]},
      "recovery": "Correct the fresh evidence binding and retry."
    },
    {
      "transition_id": "TR-VAL-009",
      "command_or_event": "record_verdict",
      "from_state": "evidence_stale",
      "allowed": false,
      "actor_authority": {"roles": ["conformance_validator"], "quorum": 1, "distinct_actors": false, "delegation": "forbidden"},
      "preconditions": ["fresh required evidence has returned the claim to awaiting_evidence"],
      "base_references": ["claim_id", "stale_evidence_digest"],
      "emitted_records": ["EvidenceTransitionDenied"],
      "filesystem_effects": ["none"],
      "idempotency": {"key_fields": ["claim_id", "command"], "retry_result": "return the original denial"},
      "terminal_state": "evidence_stale",
      "failure_result": {"code": "evidence.fresh_input_required", "state_effect": "unchanged", "emitted_records": ["EvidenceTransitionDenied"], "filesystem_effects": ["none"]},
      "recovery": "Supply fresh required evidence before recording another verdict."
    },
    {
      "transition_id": "TR-VAL-010",
      "command_or_event": "readback",
      "from_state": "evidence_stale",
      "allowed": true,
      "actor_authority": {"roles": ["conformance_validator"], "quorum": 1, "distinct_actors": false, "delegation": "forbidden"},
      "preconditions": ["the stale evidence binding remains declared"],
      "base_references": ["claim_id", "stale_evidence_digest", "recovery_report_digest"],
      "emitted_records": ["EvidenceRecoveryReport"],
      "filesystem_effects": ["none"],
      "idempotency": {"key_fields": ["claim_id", "stale_evidence_digest"], "retry_result": "reproduce the same non-pass report"},
      "terminal_state": "evidence_stale",
      "failure_result": {"code": "evidence.readback_invalid", "state_effect": "unchanged", "emitted_records": ["EvidenceRecoveryReport"], "filesystem_effects": ["none"]},
      "recovery": "Preserve the non-pass result until fresh evidence is supplied."
    },
    {
      "transition_id": "TR-VAL-011",
      "command_or_event": "mark_stale",
      "from_state": "evidence_stale",
      "allowed": true,
      "actor_authority": {"roles": ["conformance_validator"], "quorum": 1, "distinct_actors": false, "delegation": "forbidden"},
      "preconditions": ["the stale evidence binding remains declared"],
      "base_references": ["claim_id", "stale_evidence_digest", "recovery_report_digest"],
      "emitted_records": ["EvidenceRecoveryReport"],
      "filesystem_effects": ["none"],
      "idempotency": {"key_fields": ["claim_id", "stale_evidence_digest"], "retry_result": "return the existing stale report"},
      "terminal_state": "evidence_stale",
      "failure_result": {"code": "evidence.readback_invalid", "state_effect": "unchanged", "emitted_records": ["EvidenceRecoveryReport"], "filesystem_effects": ["none"]},
      "recovery": "Preserve the non-pass result until fresh evidence is supplied."
    },
    {
      "transition_id": "TR-VAL-012",
      "command_or_event": "supply_fresh_evidence",
      "from_state": "evidence_stale",
      "allowed": true,
      "actor_authority": {"roles": ["evidence_supplier"], "quorum": 1, "distinct_actors": false, "delegation": "permitted"},
      "preconditions": ["new required evidence is explicitly declared"],
      "base_references": ["claim_id", "recorded_claim_digest", "fresh_claim_digest", "fresh_invocation_digest"],
      "emitted_records": ["FreshEvidenceSupplied"],
      "filesystem_effects": ["stage declared evidence only"],
      "idempotency": {"key_fields": ["claim_id", "input_digest"], "retry_result": "return the original supply receipt"},
      "terminal_state": "awaiting_evidence",
      "failure_result": {"code": "evidence.fresh_input_invalid", "state_effect": "unchanged", "emitted_records": ["EvidenceTransitionDenied"], "filesystem_effects": ["none"]},
      "recovery": "Correct the fresh evidence binding and retry."
    }
  ]
}
