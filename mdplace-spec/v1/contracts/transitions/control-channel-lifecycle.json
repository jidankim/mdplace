        "roles": [
          "mdplace_agent"
        ],
        "quorum": 1,
        "distinct_actors": false,
        "delegation": "forbidden"
      },
      "preconditions": [
        "Agent is starting or blocked; readiness and Exclusive Writer Lock status may still be unknown or failed",
