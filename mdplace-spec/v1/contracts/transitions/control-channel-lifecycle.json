{
  "$schema": "../schemas/transition-table.schema.json",
  "schema_id": "mdplace.transition-table/v1",
  "table_id": "TRANS-CP-CONTROL-CHANNEL",
  "lifecycle": "same-user local Control Channel",
  "version": "1.0.0",
  "states": [
    "closed",
    "open"
  ],
  "commands": [
    "open_control_channel",
    "submit_control_command",
    "close_control_channel"
  ],
  "transitions": [
    {
      "transition_id": "TR-CPCHANNEL-001",
      "command_or_event": "open_control_channel",
      "from_state": "closed",
      "allowed": true,
      "actor_authority": {
        "roles": [
          "mdplace_agent"
        ],
        "quorum": 1,
        "distinct_actors": false,
        "delegation": "forbidden"
      },
      "preconditions": [
        "Agent is ready and retains the Exclusive Writer Lock",
        "socket directory mode is 0700 and socket mode is 0600"
      ],
      "base_references": [
        "vault identity",
        "Agent readiness receipt",
        "protocol version 1.0"
      ],
      "emitted_records": [
        "ControlChannelOpenReceipt"
      ],
      "filesystem_effects": [
        "create per-vault Unix-domain socket"
      ],
      "idempotency": {
        "key_fields": [
          "idempotency_key",
          "vault identity",
          "Agent readiness receipt",
          "protocol version 1.0"
        ],
        "retry_result": "return the original durable receipt for the exact binding"
      },
      "terminal_state": "open",
      "failure_result": {
        "code": "control.precondition_failed",
        "state_effect": "unchanged",
        "emitted_records": [
          "ControlPlaneTransitionDenied"
        ],
        "filesystem_effects": [
          "none"
        ]
      },
      "recovery": "Remove an unowned stale socket and reopen only after readiness passes."
    },
    {
      "transition_id": "TR-CPCHANNEL-002",
      "command_or_event": "submit_control_command",
      "from_state": "closed",
      "allowed": false,
      "actor_authority": {
        "roles": [
          "control_client"
        ],
        "quorum": 1,
        "distinct_actors": false,
        "delegation": "forbidden"
      },
      "preconditions": [
        "submit_control_command is not legal from closed"
      ],
      "base_references": [
        "exact current lifecycle state and version"
      ],
      "emitted_records": [
        "ControlPlaneTransitionDenied"
      ],
      "filesystem_effects": [
        "none"
      ],
      "idempotency": {
        "key_fields": [
          "idempotency_key",
          "exact current lifecycle state and version"
        ],
        "retry_result": "return the original denial"
      },
      "terminal_state": "closed",
      "failure_result": {
        "code": "control.illegal_transition",
        "state_effect": "unchanged",
        "emitted_records": [
          "ControlPlaneTransitionDenied"
        ],
        "filesystem_effects": [
          "none"
        ]
      },
      "recovery": "Preserve the durable state and use a command legal from the current exact version."
    },
    {
      "transition_id": "TR-CPCHANNEL-003",
      "command_or_event": "close_control_channel",
      "from_state": "closed",
      "allowed": true,
      "actor_authority": {
        "roles": [
          "mdplace_agent"
        ],
        "quorum": 1,
        "distinct_actors": false,
        "delegation": "forbidden"
      },
      "preconditions": [
        "Agent is draining, blocked, or stopping"
      ],
      "base_references": [
        "current Control Channel version",
        "vault identity"
      ],
      "emitted_records": [
        "ControlChannelCloseReceipt"
      ],
      "filesystem_effects": [
        "remove per-vault Unix-domain socket"
      ],
      "idempotency": {
        "key_fields": [
          "idempotency_key",
          "current Control Channel version",
          "vault identity"
        ],
        "retry_result": "return the original durable receipt for the exact binding"
      },
      "terminal_state": "closed",
      "failure_result": {
        "code": "control.precondition_failed",
        "state_effect": "unchanged",
        "emitted_records": [
          "ControlPlaneTransitionDenied"
        ],
        "filesystem_effects": [
          "none"
        ]
      },
      "recovery": "A repeated close returns the original receipt."
    },
    {
      "transition_id": "TR-CPCHANNEL-004",
      "command_or_event": "open_control_channel",
      "from_state": "open",
      "allowed": true,
      "actor_authority": {
        "roles": [
          "mdplace_agent"
        ],
        "quorum": 1,
        "distinct_actors": false,
        "delegation": "forbidden"
      },
      "preconditions": [
        "Agent is ready and retains the Exclusive Writer Lock",
        "socket directory mode is 0700 and socket mode is 0600"
      ],
      "base_references": [
        "vault identity",
        "Agent readiness receipt",
        "protocol version 1.0"
      ],
      "emitted_records": [
        "ControlChannelOpenReceipt"
      ],
      "filesystem_effects": [
        "create per-vault Unix-domain socket"
      ],
      "idempotency": {
        "key_fields": [
          "idempotency_key",
          "vault identity",
          "Agent readiness receipt",
          "protocol version 1.0"
        ],
        "retry_result": "return the original durable receipt for the exact binding"
      },
      "terminal_state": "open",
      "failure_result": {
        "code": "control.precondition_failed",
        "state_effect": "unchanged",
        "emitted_records": [
          "ControlPlaneTransitionDenied"
        ],
        "filesystem_effects": [
          "none"
        ]
      },
      "recovery": "Remove an unowned stale socket and reopen only after readiness passes."
    },
    {
      "transition_id": "TR-CPCHANNEL-005",
      "command_or_event": "submit_control_command",
      "from_state": "open",
      "allowed": true,
      "actor_authority": {
        "roles": [
          "control_client"
        ],
        "quorum": 1,
        "distinct_actors": false,
        "delegation": "forbidden"
      },
      "preconditions": [
        "Unix-domain transport is local",
        "peer credentials match the effective user",
        "vault scope and protocol match",
        "request, response, timeout, and concurrency budgets hold"
      ],
      "base_references": [
        "command version and idempotency key",
        "exact actionable Work Item or Work Journal base",
        "payload digest"
      ],
      "emitted_records": [
        "ControlCommandReceipt"
      ],
      "filesystem_effects": [
        "none; owning authorities revalidate every requested effect"
      ],
      "idempotency": {
        "key_fields": [
          "idempotency_key",
          "command version and idempotency key",
          "exact actionable Work Item or Work Journal base",
          "payload digest"
        ],
        "retry_result": "return the original durable receipt for the exact binding"
      },
      "terminal_state": "open",
      "failure_result": {
        "code": "control.precondition_failed",
        "state_effect": "unchanged",
        "emitted_records": [
          "ControlPlaneTransitionDenied"
        ],
        "filesystem_effects": [
          "none"
        ]
      },
      "recovery": "Return the original receipt for the exact request binding; reject stale, unauthenticated, nonlocal, or cross-vault commands."
    },
    {
      "transition_id": "TR-CPCHANNEL-006",
      "command_or_event": "close_control_channel",
      "from_state": "open",
      "allowed": true,
      "actor_authority": {
        "roles": [
          "mdplace_agent"
        ],
        "quorum": 1,
        "distinct_actors": false,
        "delegation": "forbidden"
      },
      "preconditions": [
        "Agent is draining, blocked, or stopping"
      ],
      "base_references": [
        "current Control Channel version",
        "vault identity"
      ],
      "emitted_records": [
        "ControlChannelCloseReceipt"
      ],
      "filesystem_effects": [
        "remove per-vault Unix-domain socket"
      ],
      "idempotency": {
        "key_fields": [
          "idempotency_key",
          "current Control Channel version",
          "vault identity"
        ],
        "retry_result": "return the original durable receipt for the exact binding"
      },
      "terminal_state": "closed",
      "failure_result": {
        "code": "control.precondition_failed",
        "state_effect": "unchanged",
        "emitted_records": [
          "ControlPlaneTransitionDenied"
        ],
        "filesystem_effects": [
          "none"
        ]
      },
      "recovery": "A repeated close returns the original receipt."
    }
  ]
}
