        "socket directory mode is 0700 and socket mode is 0600"
      ],
      "base_references": [
        "vault identity",
        "configured same-user runtime directory and per-vault socket path",
        "protocol version 1.0"
      ],
      "emitted_records": [
        "ControlChannelDiagnosticReceipt"
      ],
      "filesystem_effects": [
        "create per-vault Unix-domain socket in diagnostic-only mode"
      ],
      "idempotency": {
        "key_fields": [
        "idempotency_key",
        "vault identity",
        "configured same-user runtime directory and per-vault socket path",
        "protocol version 1.0"
        ],
        "retry_result": "return the original durable receipt for the exact binding"
      },
      "terminal_state": "diagnostic_only",
      "failure_result": {
        "code": "control.precondition_failed",
        "state_effect": "unchanged",
        "emitted_records": [
          "ControlPlaneTransitionDenied"
        ],
        "filesystem_effects": [
          "none"
        ]
      },
      "recovery": "Remove an unowned stale socket and reopen diagnostic-only access from the configured same-user runtime path and vault binding without admitting work or depending on a connected peer or writer-lock success."
