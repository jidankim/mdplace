        "roles": [
          "vault_owner"
        ],
        "quorum": 1,
        "distinct_actors": false,
        "delegation": "forbidden"
      },
      "preconditions": [
        "exact Source Profile evidence validates"
      ],
      "base_references": [
        "profile_id",
        "profile_version",
        "profile_sha256"
      ],
      "emitted_records": [
        "SourceProfileTransitionReceipt"
      ],
      "filesystem_effects": [
        "publish exact lifecycle result"
      ],
      "idempotency": {
        "key_fields": [
          "profile_id",
          "profile_version",
          "profile_sha256"
        ],
        "retry_result": "return the original receipt"
      },
      "terminal_state": "active",
      "failure_result": {
        "code": "source_profile.transition_denied",
        "state_effect": "recovery_required",
