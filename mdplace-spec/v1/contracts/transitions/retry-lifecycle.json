        "roles": [
          "mdplace_agent"
        ],
        "quorum": 1,
        "distinct_actors": false,
        "delegation": "forbidden"
      },
      "preconditions": [
        "failure is not retryable or retry count equals the ceiling"
      ],
      "base_references": [
        "exact Work Item version and Work Lease",
        "retry count and retry ceiling"
      ],
      "emitted_records": [
        "TerminalFailureReceipt"
      ],
      "filesystem_effects": [
        "append authenticated terminal failure"
      ],
      "idempotency": {
        "key_fields": [
          "idempotency_key",
          "exact Work Item version and Work Lease",
          "retry count and retry ceiling"
        ],
        "retry_result": "return the original durable receipt for the exact binding"
      },
      "terminal_state": "failed",
      "failure_result": {
        "code": "control.precondition_failed",
        "state_effect": "unchanged",
        "emitted_records": [
          "ControlPlaneTransitionDenied"
        ],
        "filesystem_effects": [
          "none"
        ]
      },
      "recovery": "Preserve the terminal receipt; later retry requests are denied."
    },
    {
      "transition_id": "TR-CPRETRY-003",
      "command_or_event": "retry_work",
