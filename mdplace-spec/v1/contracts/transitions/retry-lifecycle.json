{
  "$schema": "../schemas/transition-table.schema.json",
  "schema_id": "mdplace.transition-table/v1",
  "table_id": "TRANS-CP-RETRY",
  "lifecycle": "bounded Work Item retry",
  "version": "1.0.0",
  "states": [
    "executing",
    "retry_wait",
    "failed"
  ],
  "commands": [
    "record_retry",
    "record_terminal_failure",
    "retry_work"
  ],
  "transitions": [
    {
      "transition_id": "TR-CPRETRY-001",
      "command_or_event": "record_retry",
      "from_state": "executing",
      "allowed": true,
      "actor_authority": {
        "roles": [
          "mdplace_agent"
        ],
        "quorum": 1,
        "distinct_actors": false,
        "delegation": "forbidden"
      },
      "preconditions": [
        "failure is retryable",
        "retry count is below the ceiling"
      ],
      "base_references": [
        "exact Work Item version and Work Lease",
        "retry count and retry delay schedule"
      ],
      "emitted_records": [
        "RetryReceipt"
      ],
      "filesystem_effects": [
        "append retry count and durable eligibility tick"
      ],
      "idempotency": {
        "key_fields": [
          "idempotency_key",
          "exact Work Item version and Work Lease",
          "retry count and retry delay schedule"
        ],
        "retry_result": "return the original durable receipt for the exact binding"
      },
      "terminal_state": "retry_wait",
      "failure_result": {
        "code": "control.precondition_failed",
        "state_effect": "unchanged",
        "emitted_records": [
          "ControlPlaneTransitionDenied"
        ],
        "filesystem_effects": [
          "none"
        ]
      },
      "recovery": "Resume only at or after the recorded eligibility tick and never exceed the retry ceiling."
    },
    {
      "transition_id": "TR-CPRETRY-002",
      "command_or_event": "record_terminal_failure",
      "from_state": "executing",
