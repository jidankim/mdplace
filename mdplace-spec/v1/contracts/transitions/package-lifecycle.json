      "base_references": ["package_series", "release_version", "normative_digest"],
      "emitted_records": [],
      "filesystem_effects": ["none"],
      "idempotency": {"key_fields": ["package_series", "release_version", "command_or_event", "idempotency_key"], "retry_result": "return the original denial receipt"},
