      "preconditions": ["source state is released", "target version and path differ", "source digest remains preserved"],
      "base_references": ["package_series", "release_version", "normative_digest"],
      "emitted_records": [],
      "filesystem_effects": ["none"],
      "idempotency": {"key_fields": ["package_series", "release_version", "command_or_event", "idempotency_key"], "retry_result": "return the original denial receipt"},
      "terminal_state": "draft",
      "failure_result": {"code": "transition.illegal", "state_effect": "unchanged", "emitted_records": ["PackageTransitionDenied"], "filesystem_effects": ["none"]},
