    },
    {
      "transition_id": "TR-PKG-011",
      "command_or_event": "release",
      "from_state": "release_ready",
      "allowed": true,
      "actor_authority": {"roles": ["release_coordinator"], "quorum": 1, "distinct_actors": false, "delegation": "forbidden"},
