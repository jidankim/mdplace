{
  "$schema": "../schemas/transition-table.schema.json",
  "schema_id": "mdplace.transition-table/v1",
  "table_id": "TRANS-PACKAGE-LIFECYCLE",
  "lifecycle": "Specification Package release",
  "version": "1.0.0",
  "states": ["draft", "candidate", "release_ready", "released"],
  "commands": ["submit", "approve", "release", "amend"],
  "transitions": [
    {
      "transition_id": "TR-PKG-001",
      "command_or_event": "submit",
      "from_state": "draft",
      "allowed": true,
      "actor_authority": {"roles": ["package_author"], "quorum": 1, "distinct_actors": false, "delegation": "permitted"},
      "preconditions": ["candidate foundation validates", "all current artifacts are manifest-bound", "normative digest matches"],
      "base_references": ["package_series", "release_version", "normative_digest"],
      "emitted_records": ["PackageCandidateSubmitted"],
      "filesystem_effects": ["none"],
      "idempotency": {"key_fields": ["package_series", "release_version", "command_or_event", "idempotency_key"], "retry_result": "return the original submission receipt"},
      "terminal_state": "candidate",
      "failure_result": {"code": "transition.precondition_failed", "state_effect": "unchanged", "emitted_records": ["PackageTransitionDenied"], "filesystem_effects": ["none"]},
      "recovery": "Revalidate the same manifest-bound candidate; retry with the same key returns the original receipt."
    },
    {
      "transition_id": "TR-PKG-002",
      "command_or_event": "approve",
