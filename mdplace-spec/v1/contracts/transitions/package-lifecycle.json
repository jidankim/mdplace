    {
      "transition_id": "TR-PKG-006",
      "command_or_event": "approve",
      "from_state": "candidate",
      "allowed": true,
      "actor_authority": {"roles": ["vault_owner", "independent_technical_reviewer"], "quorum": 2, "distinct_actors": true, "delegation": "forbidden"},
