      "preconditions": ["state is draft", "candidate foundation validates", "normative digest matches"],
      "base_references": ["package_series", "release_version", "normative_digest"],
      "emitted_records": [],
      "filesystem_effects": ["none"],
      "idempotency": {"key_fields": ["package_series", "release_version", "command_or_event", "idempotency_key"], "retry_result": "return the original submission receipt when the key matches; otherwise deny"},
      "terminal_state": "candidate",
      "failure_result": {"code": "transition.illegal", "state_effect": "unchanged", "emitted_records": ["PackageTransitionDenied"], "filesystem_effects": ["none"]},
