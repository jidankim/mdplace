      "terminal_state": "released",
      "failure_result": {"code": "release.immutable", "state_effect": "unchanged", "emitted_records": ["PackageTransitionDenied"], "filesystem_effects": ["none"]},
      "recovery": "Open a Package Amendment at a new version and path."
    },
    {
      "transition_id": "TR-PKG-014",
      "command_or_event": "approve",
      "from_state": "released",
      "allowed": false,
      "actor_authority": {"roles": ["vault_owner", "independent_technical_reviewer"], "quorum": 2, "distinct_actors": true, "delegation": "forbidden"},
      "preconditions": ["state is candidate", "semantic and technical approvers are distinct"],
      "base_references": ["package_series", "release_version", "normative_digest"],
      "emitted_records": [],
      "filesystem_effects": ["none"],
      "idempotency": {"key_fields": ["package_series", "release_version", "command_or_event", "idempotency_key"], "retry_result": "return the original denial receipt"},
      "terminal_state": "released",
      "failure_result": {"code": "release.immutable", "state_effect": "unchanged", "emitted_records": ["PackageTransitionDenied"], "filesystem_effects": ["none"]},
      "recovery": "Open and approve a Package Amendment at a new version and path."
    },
    {
      "transition_id": "TR-PKG-015",
      "command_or_event": "release",
      "from_state": "released",
      "allowed": false,
      "actor_authority": {"roles": ["release_coordinator"], "quorum": 1, "distinct_actors": false, "delegation": "forbidden"},
      "preconditions": ["state is release_ready", "version is not already released", "approvals bind the current digest"],
      "base_references": ["package_series", "release_version", "normative_digest"],
      "emitted_records": [],
      "filesystem_effects": ["none"],
      "idempotency": {"key_fields": ["package_series", "release_version", "command_or_event", "idempotency_key"], "retry_result": "return the original release receipt only when the key matches; otherwise deny"},
      "terminal_state": "released",
      "failure_result": {"code": "release.immutable", "state_effect": "unchanged", "emitted_records": ["PackageTransitionDenied"], "filesystem_effects": ["none"]},
      "recovery": "Read the existing release receipt or open a Package Amendment."
    },
    {
      "transition_id": "TR-PKG-016",
      "command_or_event": "amend",
      "from_state": "released",
      "allowed": true,
      "actor_authority": {"roles": ["package_author"], "quorum": 1, "distinct_actors": false, "delegation": "permitted"},
      "preconditions": ["target version is greater than source version", "target path differs from source path", "source digest and bytes remain preserved", "changed and new requirement identifiers are declared"],
      "base_references": ["package_series", "release_version", "normative_digest"],
      "emitted_records": ["PackageAmendmentOpened"],
      "filesystem_effects": ["create a new draft version path", "preserve released source byte-for-byte"],
      "idempotency": {"key_fields": ["package_series", "release_version", "command_or_event", "idempotency_key"], "retry_result": "return the original amendment receipt and draft path"},
      "terminal_state": "released",
      "failure_result": {"code": "release.immutable", "state_effect": "unchanged", "emitted_records": ["PackageTransitionDenied"], "filesystem_effects": ["remove unverified partial target and preserve released source"]},
      "recovery": "Verify the source digest, discard an unverified partial target, and recreate the amendment at a new version path."
