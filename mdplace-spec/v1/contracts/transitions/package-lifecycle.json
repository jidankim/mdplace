      "base_references": ["package_series", "release_version", "normative_digest"],
      "emitted_records": ["SpecificationPackageReleased"],
      "filesystem_effects": ["publish immutable release tag", "publish specification and conformance digests", "publish validator version", "publish validation and traceability reports"],
