      "preconditions": ["state is candidate", "semantic and technical approvers are distinct"],
      "base_references": ["package_series", "release_version", "normative_digest"],
      "emitted_records": [],
      "filesystem_effects": ["none"],
      "idempotency": {"key_fields": ["package_series", "release_version", "command_or_event", "idempotency_key"], "retry_result": "return the original approval receipt when the key matches; otherwise deny"},
      "terminal_state": "release_ready",
      "failure_result": {"code": "transition.illegal", "state_effect": "unchanged", "emitted_records": ["PackageTransitionDenied"], "filesystem_effects": ["none"]},
