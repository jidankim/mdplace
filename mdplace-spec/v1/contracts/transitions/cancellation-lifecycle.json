        "roles": [
          "vault_owner"
        ],
        "quorum": 1,
        "distinct_actors": false,
        "delegation": "forbidden"
      },
      "preconditions": [
        "vault owner is authenticated",
        "exact Work Item version is current"
      ],
      "base_references": [
        "exact Work Item version",
        "current Work Lease when present"
      ],
      "emitted_records": [
        "CancellationReceipt",
        "CompletionReceipt"
      ],
      "filesystem_effects": [
        "append durable cancellation",
        "append durable terminal completion",
        "revoke active Child Work Invocation capability when present"
      ],
      "idempotency": {
        "key_fields": [
          "idempotency_key",
          "exact Work Item version",
          "current Work Lease when present"
        ],
        "retry_result": "return the original durable receipt for the exact binding"
      },
      "terminal_state": "cancelled",
      "failure_result": {
        "code": "control.precondition_failed",
        "state_effect": "unchanged",
        "emitted_records": [
          "ControlPlaneTransitionDenied"
        ],
        "filesystem_effects": [
          "none"
        ]
      },
      "recovery": "Keep the Work Item cancelled after restart and never revive it without a separate authorized resume."
    },
