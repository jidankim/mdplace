{
  "$schema": "../schemas/transition-table.schema.json",
  "schema_id": "mdplace.transition-table/v1",
  "table_id": "TRANS-CP-CANCELLATION",
  "lifecycle": "durable Work Item cancellation and authorized resume",
  "version": "1.0.0",
  "states": [
    "active",
    "cancelled"
  ],
  "commands": [
    "cancel_work",
    "resume_work"
  ],
  "transitions": [
    {
      "transition_id": "TR-CPCANCEL-001",
      "command_or_event": "cancel_work",
      "from_state": "active",
      "allowed": true,
      "actor_authority": {
        "roles": [
          "vault_owner"
        ],
        "quorum": 1,
        "distinct_actors": false,
        "delegation": "forbidden"
      },
      "preconditions": [
        "cancel_work exact bases and budgets validate"
      ],
      "base_references": [
        "current Work Journal head",
        "current lifecycle version"
      ],
      "emitted_records": [
        "cancel_work_receipt"
      ],
      "filesystem_effects": [
        "none"
      ],
      "idempotency": {
        "key_fields": [
          "idempotency_key",
          "current lifecycle version"
        ],
        "retry_result": "return original receipt"
      },
      "terminal_state": "cancelled",
      "failure_result": {
        "code": "control.precondition_failed",
        "state_effect": "unchanged",
        "emitted_records": [
          "ControlPlaneTransitionDenied"
        ],
        "filesystem_effects": [
          "none"
        ]
      },
      "recovery": "Re-read the durable receipt and exact current bases."
    },
    {
      "transition_id": "TR-CPCANCEL-002",
      "command_or_event": "resume_work",
      "from_state": "active",
      "allowed": false,
      "actor_authority": {
        "roles": [
          "vault_owner"
        ],
        "quorum": 1,
        "distinct_actors": false,
        "delegation": "forbidden"
      },
      "preconditions": [
        "resume_work is not legal from active"
      ],
      "base_references": [
        "current Work Journal head",
        "current lifecycle version"
      ],
      "emitted_records": [
        "ControlPlaneTransitionDenied"
      ],
      "filesystem_effects": [
        "none"
      ],
      "idempotency": {
        "key_fields": [
          "idempotency_key",
          "current lifecycle version"
        ],
        "retry_result": "return original denial"
      },
      "terminal_state": "active",
      "failure_result": {
        "code": "control.illegal_transition",
        "state_effect": "unchanged",
        "emitted_records": [
          "ControlPlaneTransitionDenied"
        ],
        "filesystem_effects": [
          "none"
        ]
      },
      "recovery": "Use a command legal from the current durable state."
    },
    {
      "transition_id": "TR-CPCANCEL-003",
      "command_or_event": "cancel_work",
      "from_state": "cancelled",
      "allowed": true,
      "actor_authority": {
        "roles": [
          "vault_owner"
        ],
        "quorum": 1,
        "distinct_actors": false,
        "delegation": "forbidden"
      },
      "preconditions": [
        "cancel_work exact bases and budgets validate"
      ],
      "base_references": [
        "current Work Journal head",
        "current lifecycle version"
      ],
      "emitted_records": [
        "cancel_work_receipt"
      ],
      "filesystem_effects": [
        "none"
      ],
      "idempotency": {
        "key_fields": [
          "idempotency_key",
          "current lifecycle version"
        ],
        "retry_result": "return original receipt"
      },
      "terminal_state": "cancelled",
      "failure_result": {
        "code": "control.precondition_failed",
        "state_effect": "unchanged",
        "emitted_records": [
          "ControlPlaneTransitionDenied"
        ],
        "filesystem_effects": [
          "none"
        ]
      },
      "recovery": "Re-read the durable receipt and exact current bases."
    },
    {
      "transition_id": "TR-CPCANCEL-004",
      "command_or_event": "resume_work",
      "from_state": "cancelled",
      "allowed": true,
      "actor_authority": {
        "roles": [
          "vault_owner"
        ],
        "quorum": 1,
        "distinct_actors": false,
        "delegation": "forbidden"
      },
      "preconditions": [
        "resume_work exact bases and budgets validate"
      ],
      "base_references": [
        "current Work Journal head",
        "current lifecycle version"
      ],
      "emitted_records": [
        "resume_work_receipt"
      ],
      "filesystem_effects": [
        "none"
      ],
      "idempotency": {
        "key_fields": [
          "idempotency_key",
          "current lifecycle version"
        ],
        "retry_result": "return original receipt"
      },
      "terminal_state": "active",
      "failure_result": {
        "code": "control.precondition_failed",
        "state_effect": "unchanged",
        "emitted_records": [
          "ControlPlaneTransitionDenied"
        ],
        "filesystem_effects": [
          "none"
        ]
      },
      "recovery": "Re-read the durable receipt and exact current bases."
    }
  ]
}
