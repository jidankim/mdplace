{
  "$schema": "../schemas/transition-table.schema.json",
  "schema_id": "mdplace.transition-table/v1",
  "table_id": "TRANS-PROCESSING-POLICY",
  "lifecycle": "Processing Policy approval and revocation",
  "version": "1.0.0",
  "states": ["draft", "active", "revoked"],
  "commands": ["activate_policy", "revoke_policy"],
  "transitions": [
    {"transition_id":"TR-CPP-001","command_or_event":"activate_policy","from_state":"draft","allowed":true,"actor_authority":{"roles":["vault_owner"],"quorum":1,"distinct_actors":false,"delegation":"forbidden"},"preconditions":["closed policy validates","approval binds exact policy"],"base_references":["policy_id","policy_version","policy_sha256"],"emitted_records":["ProcessingPolicyApprovalReceipt"],"filesystem_effects":["publish approved policy binding"],"idempotency":{"key_fields":["policy_id","policy_version","policy_sha256"],"retry_result":"return the original approval receipt"},"terminal_state":"active","failure_result":{"code":"policy.activation_denied","state_effect":"unchanged","emitted_records":["ProcessingPolicyDenialReceipt"],"filesystem_effects":["none"]},"recovery":"Read back exact approved bytes or discard unapproved staging."},
    {"transition_id":"TR-CPP-002","command_or_event":"revoke_policy","from_state":"draft","allowed":false,"actor_authority":{"roles":["vault_owner"],"quorum":1,"distinct_actors":false,"delegation":"forbidden"},"preconditions":["policy is active"],"base_references":["policy_id","policy_version"],"emitted_records":["ProcessingPolicyDenialReceipt"],"filesystem_effects":["none"],"idempotency":{"key_fields":["policy_id","policy_version"],"retry_result":"return the original denial"},"terminal_state":"draft","failure_result":{"code":"policy.not_active","state_effect":"unchanged","emitted_records":["ProcessingPolicyDenialReceipt"],"filesystem_effects":["none"]},"recovery":"Leave the draft unchanged."},
    {"transition_id":"TR-CPP-003","command_or_event":"activate_policy","from_state":"active","allowed":false,"actor_authority":{"roles":["vault_owner"],"quorum":1,"distinct_actors":false,"delegation":"forbidden"},"preconditions":["policy is draft"],"base_references":["policy_id","policy_version","policy_sha256"],"emitted_records":["ProcessingPolicyDenialReceipt"],"filesystem_effects":["none"],"idempotency":{"key_fields":["policy_id","policy_version","policy_sha256"],"retry_result":"return original receipt only for an exact retry"},"terminal_state":"active","failure_result":{"code":"policy.already_active","state_effect":"unchanged","emitted_records":["ProcessingPolicyDenialReceipt"],"filesystem_effects":["none"]},"recovery":"Keep the current active policy."},
    {"transition_id":"TR-CPP-004","command_or_event":"revoke_policy","from_state":"active","allowed":true,"actor_authority":{"roles":["vault_owner"],"quorum":1,"distinct_actors":false,"delegation":"forbidden"},"preconditions":["exact current policy binding is read back"],"base_references":["policy_id","policy_version","policy_sha256"],"emitted_records":["ProcessingPolicyRevocationReceipt"],"filesystem_effects":["remove credential reference binding"],"idempotency":{"key_fields":["policy_id","policy_version","policy_sha256"],"retry_result":"return the original revocation receipt"},"terminal_state":"revoked","failure_result":{"code":"policy.revocation_failed","state_effect":"unchanged","emitted_records":["ProcessingPolicyDenialReceipt"],"filesystem_effects":["none"]},"recovery":"Deny new work while exact revocation state is read back."},
    {"transition_id":"TR-CPP-005","command_or_event":"activate_policy","from_state":"revoked","allowed":false,"actor_authority":{"roles":["vault_owner"],"quorum":1,"distinct_actors":false,"delegation":"forbidden"},"preconditions":["fresh policy approval exists"],"base_references":["policy_id","policy_version"],"emitted_records":["ProcessingPolicyDenialReceipt"],"filesystem_effects":["none"],"idempotency":{"key_fields":["policy_id","policy_version"],"retry_result":"return the original denial"},"terminal_state":"revoked","failure_result":{"code":"policy.fresh_consent_required","state_effect":"unchanged","emitted_records":["ProcessingPolicyDenialReceipt"],"filesystem_effects":["none"]},"recovery":"Create a new policy version and obtain fresh consent."},
    {"transition_id":"TR-CPP-006","command_or_event":"revoke_policy","from_state":"revoked","allowed":false,"actor_authority":{"roles":["vault_owner"],"quorum":1,"distinct_actors":false,"delegation":"forbidden"},"preconditions":["policy is active"],"base_references":["policy_id","policy_version"],"emitted_records":["ProcessingPolicyDenialReceipt"],"filesystem_effects":["none"],"idempotency":{"key_fields":["policy_id","policy_version"],"retry_result":"return the original denial"},"terminal_state":"revoked","failure_result":{"code":"policy.already_revoked","state_effect":"unchanged","emitted_records":["ProcessingPolicyDenialReceipt"],"filesystem_effects":["none"]},"recovery":"Keep the policy revoked."}
  ]
}
