{
  "$schema": "schemas/processing-policy-rules.schema.json",
  "schema_id": "mdplace.processing-policy-rules/v1",
  "default_deny_precedence": [
    {"order": 1, "condition": "malformed_or_unknown_structured_field", "code": "schema.unknown_field"},
    {"order": 2, "condition": "source_profile_trusted_binding_readback", "code": "source_profile.binding_required"},
    {"order": 3, "condition": "processing_policy_exact_binding", "code": "policy.version_mismatch"},
    {"order": 4, "condition": "vault_owner_approval_receipt_readback", "code": "policy.approval_denied"},
    {"order": 5, "condition": "adapter_or_provider", "code": "policy.provider_denied"},
    {"order": 6, "condition": "purpose", "code": "policy.purpose_denied"},
    {"order": 7, "condition": "field_data_class_or_disclosure", "code": "policy.field_denied"},
    {"order": 8, "condition": "artifact", "code": "policy.artifact_denied"},
    {"order": 9, "condition": "destination_or_endpoint", "code": "policy.destination_denied"},
    {"order": 10, "condition": "credential_reference_store_authentication_provider_or_purpose", "code": "policy.credential_boundary_denied"},
    {"order": 11, "condition": "budget", "code": "policy.budget_exceeded"},
    {"order": 12, "condition": "same_adapter_retry_and_aggregate_chain_budget", "code": "policy.retry_exceeded"},
    {"order": 13, "condition": "ordered_adapter_and_consent_bound_fallback", "code": "policy.fallback_denied"},
    {"order": 14, "condition": "closed_advisory_capability", "code": "policy.capability_denied"},
    {"order": 15, "condition": "semantic_authority", "code": "policy.semantic_authority_denied"},
    {"order": 16, "condition": "automation_scope", "code": "policy.automation_scope_denied"},
    {"order": 17, "condition": "trusted_exact_redaction_receipt", "code": "policy.redaction_unproven"},
    {"order": 18, "condition": "destination_bound_retention_and_unknown_risk_acknowledgment", "code": "policy.retention_unproven"},
    {"order": 19, "condition": "hostile_content", "code": "policy.hostile_content_capability_denied"}
  ],
  "narrowing_dimensions": [
    {"dimension": "provider", "rule": "adapter_and_provider_set_subset"},
    {"dimension": "purpose", "rule": "set_subset"},
    {"dimension": "disclosure", "rule": "field_and_data_class_preserved_and_local_only_is_narrower"},
    {"dimension": "artifact", "rule": "set_subset"},
    {"dimension": "destination", "rule": "identical_tuple_subset"},
    {"dimension": "credential_boundary", "rule": "same_reference_store_authentication_provider_and_purpose_subset"},
    {"dimension": "budget", "rule": "all_numeric_maxima_nonincreasing"},
    {"dimension": "retry", "rule": "all_numeric_maxima_nonincreasing"},
    {"dimension": "fallback", "rule": "order_preserving_identical_tuple_subset"},
    {"dimension": "capability", "rule": "set_subset"},
    {"dimension": "semantic_authority", "rule": "set_subset"},
    {"dimension": "automation_scope", "rule": "set_subset"},
    {"dimension": "redaction", "rule": "applicable_obligations_preserved"},
    {"dimension": "retention", "rule": "applicable_destination_fact_preserved_and_terms_nonincreasing"}
  ],
  "source_profile_bindings": [
    "profile_identity_and_version",
    "vault_identity",
    "trusted_owner_identity",
    "capture_source_identity_and_claimed_version",
    "candidate_schema_identity_version_and_digest",
    "template_identity_version_and_import_digest",
    "url_retention_mode",
    "processing_policy_identity_version_and_digest",
    "capture_contract_identity_version_and_digest",
    "vault_owner_approval_payload_digest",
    "approval_receipt_digest_and_manifest_bound_trusted_readback"
  ]
}
