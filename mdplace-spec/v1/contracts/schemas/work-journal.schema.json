{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:work-journal:v1",
  "title": "mdplace durable non-semantic Work Journal",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "journal_id", "vault_id", "head_sequence", "head_digest", "semantic_authority", "limits", "work_items", "receipts"],
  "properties": {
    "$schema": {"const": "../schemas/work-journal.schema.json"},
    "schema_id": {"const": "mdplace.work-journal/v1"},
    "journal_id": {"type": "string", "pattern": "^journal:[a-z0-9-]{3,64}$"},
    "vault_id": {"type": "string", "pattern": "^vault:[a-z0-9-]{3,64}$"},
    "head_sequence": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "head_digest": {"$ref": "#/$defs/digest"},
    "semantic_authority": {"const": "none"},
    "limits": {"$ref": "#/$defs/limits"},
    "work_items": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/workItem"}},
    "receipts": {"type": "array", "maxItems": 20000, "items": {"$ref": "#/$defs/receipt"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_total_attempts", "retry_delays_ms", "max_recovery_interruptions", "max_resume_count", "lease_duration_ticks"],
      "properties": {
        "max_total_attempts": {"const": 3},
        "retry_delays_ms": {"const": [1000, 5000]},
        "max_recovery_interruptions": {"const": 2},
        "max_resume_count": {"const": 1},
        "lease_duration_ticks": {"const": 300}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "wall_time_ms", "max_output_bytes", "max_child_processes"],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 3},
        "wall_time_ms": {"type": "integer", "minimum": 1, "maximum": 900000},
        "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 10485760},
        "max_child_processes": {"type": "integer", "minimum": 0, "maximum": 1}
      }
    },
    "lease": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["lease_id", "work_id", "owner_agent_id", "work_version", "acquired_tick", "expires_tick", "status"],
      "properties": {
        "lease_id": {"type": "string", "pattern": "^lease:[a-z0-9-]{3,64}$"},
        "work_id": {"type": "string", "pattern": "^work:[a-z0-9-]{3,64}$"},
        "owner_agent_id": {"type": "string", "pattern": "^agent:[a-z0-9-]{3,64}$"},
        "work_version": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "acquired_tick": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "expires_tick": {"type": "integer", "minimum": 1, "maximum": 1000300},
        "status": {"enum": ["active", "revoked", "expired"]}
      }
    },
    "cancellation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["receipt_id", "cancellation_id", "work_id", "work_version", "idempotency_key", "requested_by", "journal_sequence", "reason_code", "resume_count", "resume_ceiling", "signature_scheme", "signing_key_id", "signer_agent_id", "signature_digest", "authenticated"],
      "properties": {
        "receipt_id": {"type": "string", "pattern": "^cancellation-receipt:[a-z0-9-]{3,64}$"},
        "cancellation_id": {"type": "string", "pattern": "^cancel:[a-z0-9-]{3,64}$"},
        "work_id": {"type": "string", "pattern": "^work:[a-z0-9-]{3,64}$"},
        "work_version": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "idempotency_key": {"type": "string", "pattern": "^idempotency:[a-z0-9-]{3,64}$"},
        "requested_by": {"type": "string", "pattern": "^(person|component):[a-z0-9-]{3,64}$"},
        "journal_sequence": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "reason_code": {"enum": ["user_requested", "dependency_revoked", "budget_revoked", "shutdown"]},
        "resume_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "resume_ceiling": {"const": 1},
        "signature_scheme": {"const": "hmac-sha256"},
        "signing_key_id": {"const": "signer-key:primary-001"},
        "signer_agent_id": {"type": "string", "pattern": "^agent:[a-z0-9-]{3,64}$"},
        "signature_digest": {"$ref": "#/$defs/digest"},
        "authenticated": {"const": true}
      }
    },
    "result": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["outcome", "receipt_id", "work_version", "lease_id", "journal_sequence", "output_digest", "code", "signature_scheme", "signing_key_id", "signer_agent_id", "signature_digest", "authenticated"],
      "properties": {
        "outcome": {"enum": ["succeeded", "failed", "cancelled"]},
        "receipt_id": {"type": "string", "pattern": "^receipt:[a-z0-9-]{3,64}$"},
        "work_version": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "lease_id": {"type": ["string", "null"], "pattern": "^lease:[a-z0-9-]{3,64}$"},
        "journal_sequence": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "output_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "code": {"enum": ["control.cancelled", "control.execution_failed", "control.recovery_ceiling_exceeded", "control.retry_ceiling_exceeded", "control.retry_tick_overflow", null]},
        "signature_scheme": {"const": "hmac-sha256"},
        "signing_key_id": {"const": "signer-key:primary-001"},
        "signer_agent_id": {"type": "string", "pattern": "^agent:[a-z0-9-]{3,64}$"},
        "signature_digest": {"$ref": "#/$defs/digest"},
        "authenticated": {"const": true}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference_id", "version", "digest"],
      "properties": {
        "kind": {"enum": ["work_item", "semantic_head", "mutation_plan"]},
        "reference_id": {"type": "string", "pattern": "^(work|semantic|plan):[a-z0-9-]{3,64}$"},
        "version": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_id", "work_kind", "work_version", "state", "idempotency_key", "input_digest", "dependencies", "budget", "retry_count", "retry_eligible_tick", "recovery_interruption_count", "lease", "cancellation", "result"],
      "properties": {
        "work_id": {"type": "string", "pattern": "^work:[a-z0-9-]{3,64}$"},
        "work_kind": {"enum": ["capture_promotion", "placement_evaluation", "taxonomy_evolution", "view_rebuild", "intelligence_adapter", "folder_projection"]},
        "work_version": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "state": {"enum": ["queued", "leased", "executing", "retry_wait", "cancelled", "succeeded", "failed"]},
        "idempotency_key": {"type": "string", "pattern": "^idempotency:[a-z0-9-]{3,64}$"},
        "input_digest": {"$ref": "#/$defs/digest"},
        "dependencies": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/dependency"}},
        "budget": {"$ref": "#/$defs/budget"},
        "retry_count": {"type": "integer", "minimum": 0, "maximum": 2},
        "retry_eligible_tick": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000},
        "recovery_interruption_count": {"type": "integer", "minimum": 0, "maximum": 2},
        "lease": {"$ref": "#/$defs/lease"},
        "cancellation": {"$ref": "#/$defs/cancellation"},
        "result": {"$ref": "#/$defs/result"}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "receipt_kind", "journal_sequence", "work_id", "work_version", "lease_id", "state", "operation_digest", "semantic_state_digest"],
      "properties": {
        "receipt_id": {"type": "string", "pattern": "^(receipt|cancellation-receipt):[a-z0-9-]{3,64}$"},
        "receipt_kind": {"enum": ["enqueue", "lease", "start", "retry", "cancellation", "resume", "completion", "rejection", "recovery"]},
        "journal_sequence": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "work_id": {"type": "string", "pattern": "^work:[a-z0-9-]{3,64}$"},
        "work_version": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "lease_id": {"type": ["string", "null"], "pattern": "^lease:[a-z0-9-]{3,64}$"},
        "state": {"enum": ["queued", "leased", "executing", "retry_wait", "cancelled", "succeeded", "failed", "rejected"]},
        "operation_digest": {"$ref": "#/$defs/digest"},
        "semantic_state_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
