{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:local-adapter-recovery-report:v1",
  "title": "mdplace Local Intelligence Adapter recovery report",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "report_id", "profile_id", "claim_manifest_sha256", "evidence_digest", "parsed_artifacts_revalidated", "cases", "verdict"],
  "properties": {
    "$schema": {"const": "../../contracts/schemas/local-adapter-recovery-report.schema.json"},
    "schema_id": {"const": "mdplace.local-adapter-recovery-report/v1"},
    "report_id": {"const": "local-adapter-recovery:v1"},
    "profile_id": {"const": "local-adapter"},
    "claim_manifest_sha256": {"$ref": "#/$defs/digest"},
    "evidence_digest": {"$ref": "#/$defs/digest"},
    "parsed_artifacts_revalidated": {"const": true},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}},
    "verdict": {"enum": ["pass", "fail", "unsupported", "inconclusive"]}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "case": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "claim_digest_revalidated", "parsed_evidence_revalidated", "terminal_state", "receipt_sha256"], "properties": {"fixture_id": {"type": "string", "pattern": "^FIX-LIA-PROFILE-[0-9]{3}$"}, "claim_digest_revalidated": {"type": "boolean"}, "parsed_evidence_revalidated": {"type": "boolean"}, "terminal_state": {"enum": ["validated", "recovered", "recovery_required", "denied", "interrupted", "cancelled"]}, "receipt_sha256": {"$ref": "#/$defs/digest"}}}
  }
}
