{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:control-plane-recovery-matrix:v1",
  "title": "mdplace default-deny Work Recovery matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "matrix_id", "version", "semantic_authority", "rows"],
  "properties": {
    "$schema": {"const": "../schemas/control-plane-recovery-matrix.schema.json"},
    "schema_id": {"const": "mdplace.control-plane-recovery-matrix/v1"},
    "matrix_id": {"const": "RECOVERY-CP-001"},
    "version": {"const": "1.0.0"},
    "semantic_authority": {"const": "none"},
    "rows": {"type": "array", "minItems": 12, "maxItems": 32, "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "stringList": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles", "quorum", "distinct_actors", "delegation"],
      "properties": {
        "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "quorum": {"type": "integer", "minimum": 1, "maximum": 4},
        "distinct_actors": {"type": "boolean"},
        "delegation": {"enum": ["permitted", "forbidden"]}
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "interruption_point", "actor_authority", "durable_observations", "preconditions", "base_references", "emitted_records", "filesystem_effects", "idempotency", "terminal_result", "failure_result", "recovery", "default_decision"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^RC-CP-[0-9]{3}$"},
        "interruption_point": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "actor_authority": {"$ref": "#/$defs/authority"},
        "durable_observations": {"$ref": "#/$defs/stringList"},
        "preconditions": {"$ref": "#/$defs/stringList"},
        "base_references": {"$ref": "#/$defs/stringList"},
        "emitted_records": {"$ref": "#/$defs/stringList"},
        "filesystem_effects": {"$ref": "#/$defs/stringList"},
        "idempotency": {"type": "string", "minLength": 1},
        "terminal_result": {"type": "string", "minLength": 1},
        "failure_result": {"type": "string", "minLength": 1},
        "recovery": {"type": "string", "minLength": 1},
        "default_decision": {"enum": ["resume", "preserve", "requeue", "fail", "block", "deny"]}
      }
    }
  }
}
