{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:agent-state:v1",
  "title": "mdplace Agent lifecycle and Readiness Gate state",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "persistent_agent_id", "instance_id", "vault_id", "state", "supervisor", "semantic_authority", "writer_lock", "readiness_gates", "control_channel_state"],
  "properties": {
    "$schema": {"const": "../schemas/agent-state.schema.json"},
    "schema_id": {"const": "mdplace.agent-state/v1"},
    "persistent_agent_id": {"type": "string", "pattern": "^agent:[a-z0-9-]{3,64}$"},
    "instance_id": {"type": "string", "pattern": "^agent-instance:[a-z0-9-]{3,64}$"},
    "vault_id": {"type": "string", "pattern": "^vault:[a-z0-9-]{3,64}$"},
    "state": {"enum": ["stopped", "starting", "recovering", "ready", "draining", "blocked"]},
    "supervisor": {"const": "launchd_launchagent"},
    "semantic_authority": {"const": "none"},
    "writer_lock": {"$ref": "#/$defs/writerLock"},
    "readiness_gates": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        {"$ref": "#/$defs/readinessGate", "properties": {"ordinal": {"const": 1}, "gate": {"const": "exclusive_writer"}}},
        {"$ref": "#/$defs/readinessGate", "properties": {"ordinal": {"const": 2}, "gate": {"const": "vault_filesystem"}}},
        {"$ref": "#/$defs/readinessGate", "properties": {"ordinal": {"const": 3}, "gate": {"const": "semantic_kernel"}}},
        {"$ref": "#/$defs/readinessGate", "properties": {"ordinal": {"const": 4}, "gate": {"const": "compatibility"}}},
        {"$ref": "#/$defs/readinessGate", "properties": {"ordinal": {"const": 5}, "gate": {"const": "derived_views"}}},
        {"$ref": "#/$defs/readinessGate", "properties": {"ordinal": {"const": 6}, "gate": {"const": "work_journal"}}},
        {"$ref": "#/$defs/readinessGate", "properties": {"ordinal": {"const": 7}, "gate": {"const": "control_channel"}}}
      ],
      "items": false
    },
    "control_channel_state": {"enum": ["closed", "open", "draining"]}
  },
  "if": {"properties": {"state": {"const": "ready"}}},
  "then": {
    "properties": {
      "writer_lock": {
        "properties": {
          "owner_agent_id": {"type": "string", "pattern": "^agent:[a-z0-9-]{3,64}$"},
          "token_digest": {"$ref": "#/$defs/digest"},
          "retained": {"const": true}
        }
      },
      "readiness_gates": {
        "prefixItems": [
          {"properties": {"verdict": {"const": "pass"}, "receipt_id": {"type": "string", "pattern": "^readiness-receipt:[a-z0-9-]{3,64}$"}}},
          {"properties": {"verdict": {"const": "pass"}, "receipt_id": {"type": "string", "pattern": "^readiness-receipt:[a-z0-9-]{3,64}$"}}},
          {"properties": {"verdict": {"const": "pass"}, "receipt_id": {"type": "string", "pattern": "^readiness-receipt:[a-z0-9-]{3,64}$"}}},
          {"properties": {"verdict": {"const": "pass"}, "receipt_id": {"type": "string", "pattern": "^readiness-receipt:[a-z0-9-]{3,64}$"}}},
          {"properties": {"verdict": {"const": "pass"}, "receipt_id": {"type": "string", "pattern": "^readiness-receipt:[a-z0-9-]{3,64}$"}}},
          {"properties": {"verdict": {"const": "pass"}, "receipt_id": {"type": "string", "pattern": "^readiness-receipt:[a-z0-9-]{3,64}$"}}},
          {"properties": {"verdict": {"const": "pass"}, "receipt_id": {"type": "string", "pattern": "^readiness-receipt:[a-z0-9-]{3,64}$"}}}
        ]
      },
      "control_channel_state": {"const": "open"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "writerLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lock_id", "epoch", "owner_agent_id", "token_digest", "retained"],
      "properties": {
        "lock_id": {"type": "string", "pattern": "^writer-lock:[a-z0-9-]{3,64}$"},
        "epoch": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "owner_agent_id": {"type": ["string", "null"], "pattern": "^agent:[a-z0-9-]{3,64}$"},
        "token_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "retained": {"type": "boolean"}
      }
    },
    "readinessGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "gate", "verdict", "receipt_id"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 7},
        "gate": {"enum": ["exclusive_writer", "vault_filesystem", "semantic_kernel", "compatibility", "derived_views", "work_journal", "control_channel"]},
        "verdict": {"enum": ["pending", "pass", "fail"]},
        "receipt_id": {"type": ["string", "null"], "pattern": "^readiness-receipt:[a-z0-9-]{3,64}$"}
      }
    }
  }
}
