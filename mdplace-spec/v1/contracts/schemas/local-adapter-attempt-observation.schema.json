{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:local-adapter-attempt-observation:v1",
  "title": "mdplace Local Intelligence Adapter exact attempt observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "scenario_id", "observed_started_at", "observed_completed_at", "isolation"],
  "properties": {
    "schema_id": {"const": "mdplace.local-adapter-attempt-observation/v1"},
    "scenario_id": {"type": "string", "pattern": "^LIA-[0-9]{3}$"},
    "observed_started_at": {"const": "2026-08-22T00:00:00.000Z"},
    "observed_completed_at": {"$ref": "#/$defs/timestamp"},
    "isolation": {"$ref": "#/$defs/isolation"}
  },
  "$defs": {
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"},
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ephemeral", "fresh_process", "filesystem", "tools", "ambient_configuration", "credential_visibility", "network_scope", "effective_capabilities", "canary"],
      "properties": {
        "ephemeral": {"type": "boolean"},
        "fresh_process": {"type": "boolean"},
        "filesystem": {"enum": ["none", "present"]},
        "tools": {"enum": ["none", "present"]},
        "ambient_configuration": {"enum": ["unreadable", "readable"]},
        "credential_visibility": {"enum": ["none", "visible"]},
        "network_scope": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "effective_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "canary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["canary_id", "challenge", "expected", "observed", "passed"],
          "properties": {
            "canary_id": {"type": "string", "minLength": 1},
            "challenge": {"type": "string", "minLength": 1},
            "expected": {"type": "string", "minLength": 1},
            "observed": {"type": "string", "minLength": 1},
            "passed": {"type": "boolean"}
          }
        }
      }
    }
  }
}
