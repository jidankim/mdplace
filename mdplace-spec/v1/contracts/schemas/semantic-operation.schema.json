{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:semantic-operation:v1",
  "title": "mdplace canonical semantic OperationCommit",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "operation_id", "schema_version", "command_id", "actor_authority", "operation_kind", "base_references", "ordering", "payload", "idempotency", "preconditions", "closure_receipt", "operation_digest"],
  "properties": {
    "$schema": {"const": "semantic-operation.schema.json"},
    "schema_id": {"const": "mdplace.semantic-operation/v1"},
    "operation_id": {"type": "string", "pattern": "^operation:[a-z0-9][a-z0-9-]{2,63}$"},
    "schema_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "command_id": {"type": "string", "pattern": "^command:[a-z0-9][a-z0-9-]{2,63}$"},
    "actor_authority": {"$ref": "#/$defs/actorAuthority"},
    "operation_kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "base_references": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/baseReference"}},
    "ordering": {"$ref": "#/$defs/ordering"},
    "payload": {"$ref": "#/$defs/payload"},
    "idempotency": {"$ref": "#/$defs/idempotency"},
    "preconditions": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/precondition"}},
    "closure_receipt": {"$ref": "#/$defs/closureReceipt"},
    "operation_digest": {"$ref": "#/$defs/digest"}
  },
  "oneOf": [
    {"properties": {"operation_kind": {"const": "semantic_assignment"}, "payload": {"$ref": "#/$defs/assignmentEventList"}}},
    {"properties": {"operation_kind": {"const": "semantic_removal"}, "payload": {"$ref": "#/$defs/removalEventList"}}},
    {"properties": {"operation_kind": {"const": "compatibility_marker"}, "payload": {"$ref": "#/$defs/markerEventList"}}},
    {"properties": {"operation_kind": {"type": "string", "pattern": "^future_[a-z0-9_]{2,56}$"}, "payload": {"$ref": "#/$defs/futureEventList"}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "actorAuthority": {
      "type": "object", "additionalProperties": false,
      "required": ["actor_id", "actor_kind", "authority_ref"],
      "properties": {
        "actor_id": {"type": "string", "pattern": "^(person|component):[a-z0-9][a-z0-9-]{2,63}$"},
        "actor_kind": {"enum": ["vault_owner", "mdplace_agent", "foreground_recovery", "capture_adapter", "intelligence_adapter", "folder_projection", "projection", "frontmatter_bridge", "cache"]},
        "authority_ref": {"type": "string", "pattern": "^authority:[a-z0-9][a-z0-9-]{2,63}$"}
      }
    },
    "semanticHead": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "kind", "sequence", "operation_id", "state_digest"],
      "properties": {
        "ordinal": {"const": 0}, "kind": {"const": "semantic_head"},
        "sequence": {"type": "integer", "minimum": 0},
        "operation_id": {"type": ["string", "null"], "pattern": "^operation:[a-z0-9][a-z0-9-]{2,63}$"},
        "state_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "boundInput": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "kind", "ref_id", "digest"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 15}, "kind": {"const": "bound_input"},
        "ref_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}:[a-z0-9][a-z0-9-]{2,63}$"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "baseReference": {"oneOf": [{"$ref": "#/$defs/semanticHead"}, {"$ref": "#/$defs/boundInput"}]},
    "ordering": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "predecessor_operation_id", "sort_key"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "predecessor_operation_id": {"type": ["string", "null"], "pattern": "^operation:[a-z0-9][a-z0-9-]{2,63}$"},
        "sort_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9:-]{2,127}$"}
      }
    },
    "eventPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9/._-]{1,127}$"},
        "value": {"type": ["string", "null"], "maxLength": 1024, "pattern": "^(?!.*[\\uD800-\\uDFFF]).*$"}
      }
    },
    "assignmentEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "ordinal", "event_kind", "schema_version", "payload"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^event:[a-z0-9][a-z0-9-]{2,63}$"},
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 31},
        "event_kind": {"const": "semantic_assignment"},
        "schema_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "payload": {
          "type": "object", "additionalProperties": false,
          "required": ["key", "value"],
          "properties": {
            "key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9/._-]{1,127}$"},
            "value": {"type": "string", "maxLength": 1024, "pattern": "^(?!.*[\\uD800-\\uDFFF]).*$"}
          }
        }
      }
    },
    "removalEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "ordinal", "event_kind", "schema_version", "payload"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^event:[a-z0-9][a-z0-9-]{2,63}$"},
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 31},
        "event_kind": {"const": "semantic_removal"},
        "schema_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "payload": {
          "type": "object", "additionalProperties": false,
          "required": ["key", "value"],
          "properties": {
            "key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9/._-]{1,127}$"},
            "value": {"const": null}
          }
        }
      }
    },
    "markerEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "ordinal", "event_kind", "schema_version", "payload"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^event:[a-z0-9][a-z0-9-]{2,63}$"},
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 31},
        "event_kind": {"const": "compatibility_marker"},
        "schema_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "payload": {
          "type": "object", "additionalProperties": false,
          "required": ["key", "value"],
          "properties": {
            "key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9/._-]{1,127}$"},
            "value": {"const": null}
          }
        }
      }
    },
    "futureEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "ordinal", "event_kind", "schema_version", "payload"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^event:[a-z0-9][a-z0-9-]{2,63}$"},
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 31},
        "event_kind": {"type": "string", "pattern": "^future_[a-z0-9_]{2,56}$"},
        "schema_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "payload": {"$ref": "#/$defs/eventPayload"}
      }
    },
    "assignmentEventList": {"type": "object", "additionalProperties": false, "required": ["events"], "properties": {"events": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/assignmentEvent"}}}},
    "removalEventList": {"type": "object", "additionalProperties": false, "required": ["events"], "properties": {"events": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/removalEvent"}}}},
    "markerEventList": {"type": "object", "additionalProperties": false, "required": ["events"], "properties": {"events": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/markerEvent"}}}},
    "futureEventList": {"type": "object", "additionalProperties": false, "required": ["events"], "properties": {"events": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/futureEvent"}}}},
    "payload": {"oneOf": [{"$ref": "#/$defs/assignmentEventList"}, {"$ref": "#/$defs/removalEventList"}, {"$ref": "#/$defs/markerEventList"}, {"$ref": "#/$defs/futureEventList"}]},
    "idempotency": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "command_digest"],
      "properties": {
        "key": {"type": "string", "pattern": "^idempotency:[a-z0-9][a-z0-9-]{2,63}$"},
        "command_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "precondition": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "kind", "key", "expected_value"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 31},
        "kind": {"const": "semantic_value"},
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9/._-]{1,127}$"},
        "expected_value": {"type": ["string", "null"], "maxLength": 1024, "pattern": "^(?!.*[\\uD800-\\uDFFF]).*$"}
      }
    },
    "closureReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["receipt_id", "command_id", "operation_id", "outcome", "sequence", "state_digest"],
      "properties": {
        "receipt_id": {"type": "string", "pattern": "^receipt:[a-z0-9][a-z0-9-]{2,63}$"},
        "command_id": {"type": "string", "pattern": "^command:[a-z0-9][a-z0-9-]{2,63}$"},
        "operation_id": {"type": "string", "pattern": "^operation:[a-z0-9][a-z0-9-]{2,63}$"},
        "outcome": {"const": "accepted"},
        "sequence": {"type": "integer", "minimum": 1},
        "state_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
