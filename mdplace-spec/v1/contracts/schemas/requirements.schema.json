{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:requirements:v1",
  "title": "mdplace normative requirement index",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "package_series", "requirements"],
  "properties": {
    "$schema": {"const": "../contracts/schemas/requirements.schema.json"},
    "schema_id": {"const": "mdplace.requirements/v1"},
    "package_series": {"const": "mdplace-spec/v1"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/requirement"}
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "normative_anchor",
        "decision_urls",
        "canonical_terms",
        "acceptance_gate",
        "scope"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^REQ-[A-Z][A-Z0-9]{1,15}-[0-9]{3}$"},
        "title": {"type": "string", "minLength": 1},
        "normative_anchor": {"type": "string", "pattern": "^normative/[a-z0-9-]+\\.md#req-[a-z0-9-]+$"},
        "decision_urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^https://github\\.com/jidankim/mdplace/issues/[0-9]+#issuecomment-[0-9]+$"}
        },
        "canonical_terms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "acceptance_gate": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"}
      }
    }
  }
}
