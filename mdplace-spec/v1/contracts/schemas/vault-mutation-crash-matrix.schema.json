{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:vault-mutation-crash-matrix:v1",
  "title": "mdplace Vault Mutation Gate crash-boundary matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "matrix_id", "version", "events", "interruption_modes", "boundaries"],
  "properties": {
    "$schema": {"const": "../schemas/vault-mutation-crash-matrix.schema.json"},
    "schema_id": {"const": "mdplace.vault-mutation-crash-matrix/v1"},
    "matrix_id": {"const": "CRASH-VMG-001"},
    "version": {"const": "1.0.0"},
    "events": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": {"enum": ["journal", "validation", "data", "metadata", "receipt", "echo", "readback", "commit"]}},
    "interruption_modes": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["cancel", "cancel_and_resume", "restart", "repeated_interruption"]}},
    "boundaries": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"$ref": "#/$defs/boundary"}}
  },
  "$defs": {
    "boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["boundary_id", "event", "side", "durable_prefix", "possible_effect", "required_observations", "allowed_outcomes", "mode_results", "prohibited_inference"],
      "properties": {
        "boundary_id": {"enum": ["before_journal", "after_journal", "before_validation", "after_validation", "before_data", "after_data", "before_metadata", "after_metadata", "before_receipt", "after_receipt", "before_echo", "after_echo", "before_readback", "after_readback", "before_commit", "after_commit"]},
        "event": {"enum": ["journal", "validation", "data", "metadata", "receipt", "echo", "readback", "commit"]},
        "side": {"enum": ["before", "after"]},
        "durable_prefix": {"type": "array", "uniqueItems": true, "items": {"enum": ["journal", "validation", "data", "metadata", "receipt", "echo", "readback", "commit"]}},
        "possible_effect": {"enum": ["none", "unknown", "declared_data_effect", "declared_metadata_effect"]},
        "required_observations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["authorized_plan", "ownership", "journal", "descriptor_identity", "data", "metadata", "receipt", "echo", "readback", "commit"]}},
        "allowed_outcomes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["resume", "exact_rollback", "compensate", "terminal_manual_repair"]}},
        "mode_results": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/modeResult"}},
        "prohibited_inference": {"const": "never infer success or completion from pathname or console text"}
      }
    },
    "modeResult": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "recovery_action", "terminal_state", "effect_obligation"],
      "properties": {
        "mode": {"enum": ["cancel", "cancel_and_resume", "restart", "repeated_interruption"]},
        "recovery_action": {"enum": ["resume", "exact_rollback", "compensate", "terminal_manual_repair"]},
        "terminal_state": {"enum": ["committed", "rolled_back", "compensated", "terminal_manual_repair"]},
        "effect_obligation": {"const": "preserve at-most-once effect identity; pathname and console text are non-authoritative"}
      }
    }
  }
}
