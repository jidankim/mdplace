{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:processing-attempt-receipt:v1",
  "title": "mdplace trusted local processing attempt accounting receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "receipt_id", "request_id", "sequence", "adapter_id", "consent_binding_id", "fallback_position", "outcome", "accounting_kind", "payload_sha256", "usage", "issuer", "identity_assurance", "verification_method", "receipt_sha256"],
  "oneOf": [
    {"properties": {"outcome": {"const": "safe_transient_failure"}, "accounting_kind": {"const": "measured"}}},
    {"properties": {"outcome": {"const": "pending"}, "accounting_kind": {"const": "reserved"}}}
  ],
  "properties": {
    "$schema": {"const": "contracts/schemas/processing-attempt-receipt.schema.json"},
    "schema_id": {"const": "mdplace.processing-attempt-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^attempt-receipt:[a-z][a-z0-9-]{2,63}$"},
    "request_id": {"type": "string", "pattern": "^request:[a-z][a-z0-9-]{2,63}$"},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 2},
    "adapter_id": {"type": "string", "pattern": "^adapter:[a-z][a-z0-9-]{2,63}$"},
    "consent_binding_id": {"type": "string", "pattern": "^consent:[a-z][a-z0-9-]{2,63}$"},
    "fallback_position": {"type": "integer", "minimum": 0, "maximum": 1},
    "outcome": {"enum": ["safe_transient_failure", "pending"]},
    "accounting_kind": {"enum": ["measured", "reserved"]},
    "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_bytes", "output_bytes", "elapsed_ms", "cost_microunits"],
      "properties": {
        "input_bytes": {"type": "integer", "minimum": 0, "maximum": 10000000},
        "output_bytes": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "elapsed_ms": {"type": "integer", "minimum": 0, "maximum": 3600000},
        "cost_microunits": {"type": "integer", "minimum": 0, "maximum": 1000000000}
      }
    },
    "issuer": {"const": "mdplace_local_attempt_accountant"},
    "identity_assurance": {"const": "trusted_local_accountant"},
    "verification_method": {"const": "manifest_bound_attempt_accounting_readback"},
    "receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
