{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:launchagent-supervision-profile:v1",
  "title": "mdplace LaunchAgent supervision profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "profile_id", "persistent_agent_id", "vault_id", "max_automatic_restart_attempts", "automatic_restart_delay_ticks", "persistent_circuit_breaker", "wake_revalidation", "lifecycle_table", "scope"],
  "properties": {
    "$schema": {"const": "../schemas/launchagent-supervision-profile.schema.json"},
    "schema_id": {"const": "mdplace.launchagent-supervision-profile/v1"},
    "profile_id": {"type": "string", "pattern": "^launchagent-supervision-profile:[a-z0-9-]{3,64}$"},
    "persistent_agent_id": {"type": "string", "pattern": "^agent:[a-z0-9-]{3,64}$"},
    "vault_id": {"type": "string", "pattern": "^vault:[a-z0-9-]{3,64}$"},
    "max_automatic_restart_attempts": {"const": 3},
    "automatic_restart_delay_ticks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [{"const": 1000}, {"const": 5000}, {"const": 30000}],
      "items": false
    },
    "persistent_circuit_breaker": {"$ref": "#/$defs/circuitBreaker"},
    "wake_revalidation": {"$ref": "#/$defs/wakeRevalidation"},
    "lifecycle_table": {"const": "contracts/transitions/launchagent-supervision-lifecycle.json"},
    "scope": {"const": "The numeric restart schedule is a v1 conformance specialization, not an issue-28 requirement."}
  },
  "$defs": {
    "circuitBreaker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage", "trip_on_failure_count", "qualifying_failure_classes", "requires_owner_approval"],
      "properties": {
        "storage": {"const": "durable_agent_state"},
        "trip_on_failure_count": {"const": 3},
        "qualifying_failure_classes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "prefixItems": [
            {"const": "unexpected_exit"},
            {"const": "integrity_failure"},
            {"const": "wake_revalidation_failure"}
          ],
          "items": false
        },
        "requires_owner_approval": {"const": true}
      }
    },
    "wakeRevalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks", "work_admission_while_pending", "work_admission_after_pass"],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "prefixItems": [
            {"const": "exclusive_writer"},
            {"const": "vault_filesystem"},
            {"const": "filesystem_drift"}
          ],
          "items": false
        },
        "work_admission_while_pending": {"const": "diagnostic_only"},
        "work_admission_after_pass": {"const": "work_admitting"}
      }
    }
  }
}
