{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:control-plane-scenario:v1",
  "title": "mdplace stateful control-plane scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "scenario_id", "initial", "action"],
  "properties": {
    "schema_id": {"const": "mdplace.control-plane-scenario/v1"},
    "scenario_id": {"type": "string", "pattern": "^CP-[0-9]{3}$"},
    "initial": {"$ref": "#/$defs/initial"},
    "action": {"$ref": "#/$defs/action"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "completionReceipt": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["receipt_id", "work_id", "work_version", "lease_id", "journal_sequence", "outcome", "output_digest", "code", "signature_scheme", "signing_key_id", "signer_agent_id", "signature_digest", "authenticated"],
      "properties": {
        "receipt_id": {"type": "string", "pattern": "^receipt:[a-z0-9-]{3,64}$"},
        "work_id": {"type": "string", "pattern": "^work:[a-z0-9-]{3,64}$"},
        "work_version": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "lease_id": {"type": ["string", "null"], "pattern": "^lease:[a-z0-9-]{3,64}$"},
        "journal_sequence": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "outcome": {"enum": ["succeeded", "failed", "cancelled"]},
        "output_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "code": {"enum": ["control.cancelled", "control.execution_failed", "control.recovery_ceiling_exceeded", "control.retry_ceiling_exceeded", "control.retry_tick_overflow", null]},
        "signature_scheme": {"const": "hmac-sha256"},
        "signing_key_id": {"const": "signer-key:primary-001"},
        "signer_agent_id": {"type": "string", "pattern": "^agent:[a-z0-9-]{3,64}$"},
        "signature_digest": {"$ref": "#/$defs/digest"},
        "authenticated": {"type": "boolean"}
      }
    },
    "cancellationReceipt": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["receipt_id", "cancellation_id", "work_id", "work_version", "idempotency_key", "journal_sequence", "reason_code", "signature_scheme", "signing_key_id", "signer_agent_id", "signature_digest", "authenticated"],
      "properties": {
        "receipt_id": {"type": "string", "pattern": "^cancellation-receipt:[a-z0-9-]{3,64}$"},
        "cancellation_id": {"type": "string", "pattern": "^cancel:[a-z0-9-]{3,64}$"},
        "work_id": {"type": "string", "pattern": "^work:[a-z0-9-]{3,64}$"},
        "work_version": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "idempotency_key": {"type": "string", "pattern": "^idempotency:[a-z0-9-]{3,64}$"},
        "journal_sequence": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "reason_code": {"const": "user_requested"},
        "signature_scheme": {"const": "hmac-sha256"},
        "signing_key_id": {"const": "signer-key:primary-001"},
        "signer_agent_id": {"type": "string", "pattern": "^agent:[a-z0-9-]{3,64}$"},
        "signature_digest": {"$ref": "#/$defs/digest"},
        "authenticated": {"const": true}
      }
    },
    "leaseReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "receipt_kind", "lease_id", "work_id", "work_version", "journal_sequence", "owner_agent_id", "signature_scheme", "signing_key_id", "signer_agent_id", "signature_digest", "authenticated"],
      "properties": {
        "receipt_id": {"type": "string", "pattern": "^lease-receipt:[a-z0-9-]{3,64}$"},
        "receipt_kind": {"enum": ["lease", "start"]},
        "lease_id": {"type": "string", "pattern": "^lease:[a-z0-9-]{3,64}$"},
        "work_id": {"type": "string", "pattern": "^work:[a-z0-9-]{3,64}$"},
        "work_version": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "journal_sequence": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "owner_agent_id": {"type": "string", "pattern": "^agent:[a-z0-9-]{3,64}$"},
        "signature_scheme": {"const": "hmac-sha256"},
        "signing_key_id": {"const": "signer-key:primary-001"},
        "signer_agent_id": {"type": "string", "pattern": "^agent:[a-z0-9-]{3,64}$"},
        "signature_digest": {"$ref": "#/$defs/digest"},
        "authenticated": {"const": true}
      }
    },
    "journalHeadReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "journal_id", "head_sequence", "head_digest", "signature_scheme", "signing_key_id", "signer_agent_id", "signature_digest", "authenticated"],
      "properties": {
        "receipt_id": {"type": "string", "pattern": "^journal-head-receipt:[a-z0-9-]{3,64}$"},
        "journal_id": {"type": "string", "pattern": "^journal:[a-z0-9-]{3,64}$"},
        "head_sequence": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "head_digest": {"$ref": "#/$defs/digest"},
        "signature_scheme": {"const": "hmac-sha256"},
        "signing_key_id": {"const": "signer-key:primary-001"},
        "signer_agent_id": {"type": "string", "pattern": "^agent:[a-z0-9-]{3,64}$"},
        "signature_digest": {"$ref": "#/$defs/digest"},
        "authenticated": {"const": true}
      }
    },
    "dependencyStateReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "dependencies", "signature_scheme", "signing_key_id", "signer_agent_id", "signature_digest", "authenticated"],
      "properties": {
        "receipt_id": {"type": "string", "pattern": "^dependency-state-receipt:[a-z0-9-]{3,64}$"},
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "reference_id", "version", "digest"],
            "properties": {
              "kind": {"enum": ["work_item", "semantic_head", "mutation_plan"]},
              "reference_id": {"type": "string", "pattern": "^(work|semantic|plan):[a-z0-9-]{3,64}$"},
              "version": {"type": "integer", "minimum": 0, "maximum": 1000000},
              "digest": {"$ref": "#/$defs/digest"}
            }
          }
        },
        "signature_scheme": {"const": "hmac-sha256"},
        "signing_key_id": {"const": "signer-key:primary-001"},
        "signer_agent_id": {"type": "string", "pattern": "^agent:[a-z0-9-]{3,64}$"},
        "signature_digest": {"$ref": "#/$defs/digest"},
        "authenticated": {"const": true}
      }
    },
    "work": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["work_id", "work_version", "state", "idempotency_key", "input_digest", "retry_count", "retry_ceiling", "retry_eligible_tick", "recovery_interruption_count", "lease_id", "lease_status", "lease_acquired_tick", "lease_expires_tick", "owner_agent_id", "cancellation_id", "cancellation_receipt", "resume_count", "resume_ceiling", "completion_receipt"],
      "properties": {
        "work_id": {"type": "string", "pattern": "^work:[a-z0-9-]{3,64}$"},
        "work_version": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "state": {"enum": ["queued", "leased", "executing", "retry_wait", "cancelled", "succeeded", "failed"]},
        "idempotency_key": {"type": "string", "pattern": "^idempotency:[a-z0-9-]{3,64}$"},
        "input_digest": {"$ref": "#/$defs/digest"},
        "retry_count": {"type": "integer", "minimum": 0, "maximum": 2},
        "retry_ceiling": {"const": 2},
        "retry_eligible_tick": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000},
        "recovery_interruption_count": {"type": "integer", "minimum": 0, "maximum": 2},
        "lease_id": {"type": ["string", "null"], "pattern": "^lease:[a-z0-9-]{3,64}$"},
        "lease_status": {"type": ["string", "null"], "enum": ["active", "revoked", "expired", null]},
        "lease_acquired_tick": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000},
        "lease_expires_tick": {"type": ["integer", "null"], "minimum": 1, "maximum": 1000300},
        "owner_agent_id": {"type": ["string", "null"], "pattern": "^agent:[a-z0-9-]{3,64}$"},
        "cancellation_id": {"type": ["string", "null"], "pattern": "^cancel:[a-z0-9-]{3,64}$"},
        "cancellation_receipt": {"$ref": "#/$defs/cancellationReceipt"},
        "resume_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "resume_ceiling": {"const": 1},
        "completion_receipt": {"$ref": "#/$defs/completionReceipt"}
      }
    },
    "controlChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "vault_id", "protocol_version", "command_version", "same_user_authenticated", "local_transport"],
      "properties": {
        "state": {"enum": ["closed", "open"]},
        "vault_id": {"type": "string", "pattern": "^vault:[a-z0-9-]{3,64}$"},
        "protocol_version": {"const": "1.0"},
        "command_version": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "same_user_authenticated": {"type": "boolean"},
        "local_transport": {"type": "boolean"}
      }
    },
    "writerLockReceipt": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["lock_id", "prior_epoch", "epoch", "owner_agent_id", "token_digest", "retained", "signature_scheme", "signing_key_id", "signer_agent_id", "signature_digest", "authenticated"],
      "properties": {
        "lock_id": {"type": "string", "pattern": "^writer-lock:[a-z0-9-]{3,64}$"},
        "prior_epoch": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "epoch": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "owner_agent_id": {"type": "string", "pattern": "^agent:[a-z0-9-]{3,64}$"},
        "token_digest": {"$ref": "#/$defs/digest"},
        "retained": {"const": true},
        "signature_scheme": {"const": "hmac-sha256"},
        "signing_key_id": {"const": "signer-key:primary-001"},
        "signer_agent_id": {"type": "string", "pattern": "^agent:[a-z0-9-]{3,64}$"},
        "signature_digest": {"$ref": "#/$defs/digest"},
        "authenticated": {"const": true}
      }
    },
    "readinessGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "gate", "verdict", "receipt_id", "agent_id", "vault_id", "observation_digest", "previous_receipt_digest", "signature_scheme", "signing_key_id", "signer_agent_id", "signature_digest", "authenticated"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 7},
        "gate": {"enum": ["exclusive_writer", "vault_filesystem", "semantic_kernel", "compatibility", "derived_views", "work_journal", "control_channel"]},
        "verdict": {"enum": ["pass", "fail", "not_run"]},
        "receipt_id": {"type": ["string", "null"], "pattern": "^readiness-receipt:[a-z0-9-]{3,64}$"},
        "agent_id": {"type": ["string", "null"], "pattern": "^agent:[a-z0-9-]{3,64}$"},
        "vault_id": {"type": ["string", "null"], "pattern": "^vault:[a-z0-9-]{3,64}$"},
        "observation_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "previous_receipt_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "signature_scheme": {"type": ["string", "null"], "enum": ["hmac-sha256", null]},
        "signing_key_id": {"type": ["string", "null"], "enum": ["signer-key:primary-001", null]},
        "signer_agent_id": {"type": ["string", "null"], "pattern": "^agent:[a-z0-9-]{3,64}$"},
        "signature_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "authenticated": {"type": "boolean"}
      }
    },
    "readinessObservations": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        {"$ref": "#/$defs/readinessGate", "properties": {"ordinal": {"const": 1}, "gate": {"const": "exclusive_writer"}}},
        {"$ref": "#/$defs/readinessGate", "properties": {"ordinal": {"const": 2}, "gate": {"const": "vault_filesystem"}}},
        {"$ref": "#/$defs/readinessGate", "properties": {"ordinal": {"const": 3}, "gate": {"const": "semantic_kernel"}}},
        {"$ref": "#/$defs/readinessGate", "properties": {"ordinal": {"const": 4}, "gate": {"const": "compatibility"}}},
        {"$ref": "#/$defs/readinessGate", "properties": {"ordinal": {"const": 5}, "gate": {"const": "derived_views"}}},
        {"$ref": "#/$defs/readinessGate", "properties": {"ordinal": {"const": 6}, "gate": {"const": "work_journal"}}},
        {"$ref": "#/$defs/readinessGate", "properties": {"ordinal": {"const": 7}, "gate": {"const": "control_channel"}}}
      ],
      "items": false
    },
    "initial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_state", "persistent_agent_id", "writer_owner_agent_id", "writer_epoch", "journal_available", "semantic_dependency_available", "dependency_state_digest", "dependency_state_receipt", "journal_head_sequence", "journal_head_digest", "journal_head_receipt", "active_work_count", "active_lease_ids", "max_concurrent_work", "scheduler_state_digest", "work", "control_channel", "prior_receipts", "prior_lease_receipts", "semantic_state_digest"],
      "properties": {
        "agent_state": {"enum": ["stopped", "starting", "recovering", "ready", "draining", "blocked", "crashed"]},
        "persistent_agent_id": {"type": "string", "pattern": "^agent:[a-z0-9-]{3,64}$"},
        "writer_owner_agent_id": {"type": ["string", "null"], "pattern": "^agent:[a-z0-9-]{3,64}$"},
        "writer_epoch": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "journal_available": {"type": "boolean"},
        "semantic_dependency_available": {"type": "boolean"},
        "dependency_state_digest": {"$ref": "#/$defs/digest"},
        "dependency_state_receipt": {"$ref": "#/$defs/dependencyStateReceipt"},
        "active_work_count": {"type": "integer", "minimum": 0, "maximum": 8},
        "max_concurrent_work": {"const": 8},
        "journal_head_sequence": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "journal_head_digest": {"$ref": "#/$defs/digest"},
        "journal_head_receipt": {"$ref": "#/$defs/journalHeadReceipt"},
        "active_lease_ids": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^lease:[a-z0-9-]{3,64}$"}},
        "scheduler_state_digest": {"$ref": "#/$defs/digest"},
        "work": {"$ref": "#/$defs/work"},
        "control_channel": {"$ref": "#/$defs/controlChannel"},
        "prior_receipts": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z]+Receipt:[a-z0-9:-]{3,96}$"}},
        "prior_lease_receipts": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/leaseReceipt"}},
        "semantic_state_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "actor_role", "work_id", "expected_work_version", "expected_journal_head_sequence", "expected_journal_head_digest", "expected_writer_epoch", "expected_dependency_state_digest", "expected_scheduler_state_digest", "lease_id", "idempotency_key", "proposed_work_input_digest", "retryable", "command_version", "command_vault_id", "candidate_agent_id", "current_tick", "recovery_tick", "interruption_count", "writer_lock_receipt", "readiness_observations", "semantic_write_requested", "authority_source"],
      "properties": {
        "kind": {"enum": ["enqueue", "dispatch", "acknowledge", "fail", "retry", "cancel", "resume", "restart", "recover", "readiness_check", "control_command", "acquire_writer"]},
        "actor_role": {"enum": ["work_submitter", "scheduler", "mdplace_agent", "vault_owner", "control_client", "launchd_supervisor", "operating_system"]},
        "work_id": {"type": ["string", "null"], "pattern": "^work:[a-z0-9-]{3,64}$"},
        "expected_work_version": {"type": ["integer", "null"], "minimum": 1, "maximum": 1000000},
        "expected_journal_head_sequence": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000},
        "expected_journal_head_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "expected_writer_epoch": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000},
        "expected_dependency_state_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "expected_scheduler_state_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "lease_id": {"type": ["string", "null"], "pattern": "^lease:[a-z0-9-]{3,64}$"},
        "idempotency_key": {"type": ["string", "null"], "pattern": "^idempotency:[a-z0-9-]{3,64}$"},
        "proposed_work_input_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "retryable": {"type": ["boolean", "null"]},
        "command_version": {"type": ["integer", "null"], "minimum": 1, "maximum": 1000000},
        "command_vault_id": {"type": ["string", "null"], "pattern": "^vault:[a-z0-9-]{3,64}$"},
        "candidate_agent_id": {"type": ["string", "null"], "pattern": "^agent:[a-z0-9-]{3,64}$"},
        "current_tick": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000},
        "recovery_tick": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000},
        "interruption_count": {"type": "integer", "minimum": 0, "maximum": 3},
        "writer_lock_receipt": {"$ref": "#/$defs/writerLockReceipt"},
        "readiness_observations": {"$ref": "#/$defs/readinessObservations"},
        "semantic_write_requested": {"type": "boolean"},
        "authority_source": {"enum": ["none", "work_journal", "scheduler", "mdplace_agent", "child_work", "control_channel", "readiness", "retry", "queue"]}
      }
    }
  }
}
