{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:validator-extension-registry:v1",
  "title": "mdplace validator extension registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "package_series", "release_version", "validator_version", "extensions"],
  "properties": {
    "$schema": {"const": "schemas/validator-extension-registry.schema.json"},
    "schema_id": {"const": "mdplace.validator-extension-registry/v1"},
    "package_series": {"const": "mdplace-spec/v1"},
    "release_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "validator_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "extensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/extension"}}
  },
  "$defs": {
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extension_id", "validator_id", "validator_version", "invocation_schema", "evidence_schema", "claim_manifest_schema", "recovery_schema", "transition_attempt_schema", "subject_schemas", "verdicts"],
      "properties": {
        "extension_id": {"type": "string", "pattern": "^mdplace\\.validator-extension/[a-z][a-z0-9-]*/v[1-9][0-9]*$"},
        "validator_id": {"type": "string", "pattern": "^mdplace\\.[a-z][a-z0-9-]*$"},
        "validator_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "invocation_schema": {"const": "contracts/schemas/validator-invocation.schema.json"},
        "evidence_schema": {"const": "contracts/schemas/evidence-envelope.schema.json"},
        "claim_manifest_schema": {"const": "contracts/schemas/claim-manifest.schema.json"},
        "recovery_schema": {"const": "contracts/schemas/evidence-recovery-report.schema.json"},
        "transition_attempt_schema": {"const": "contracts/schemas/evidence-transition-attempt.schema.json"},
        "subject_schemas": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^contracts/schemas/[a-z][a-z0-9-]*\\.schema\\.json$"}
        },
        "verdicts": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["pass", "fail", "unsupported", "inconclusive"]}
        }
      }
    }
  }
}
