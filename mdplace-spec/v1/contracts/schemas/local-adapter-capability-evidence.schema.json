{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:local-adapter-capability-evidence:v1",
  "title": "mdplace Local Intelligence Adapter capability evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "profile_id", "evidence_id", "status", "profile_sha256", "observed_capabilities", "denied_capabilities", "ceilings", "observed_at", "expires_at"],
  "properties": {
    "$schema": {"const": "../schemas/local-adapter-capability-evidence.schema.json"},
    "schema_id": {"const": "mdplace.local-adapter-capability-evidence/v1"},
    "profile_id": {"const": "local-adapter"},
    "evidence_id": {"const": "local-capability-evidence:v1"},
    "status": {"enum": ["current", "unsupported", "inconclusive"]},
    "profile_sha256": {"$ref": "#/$defs/digest"},
    "observed_capabilities": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["emit_schema_validated_proposal", "emit_schema_validated_receipt"]}},
    "denied_capabilities": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": {"enum": ["semantic", "note_placement", "taxonomy", "projection", "filesystem", "network", "tool", "automation"]}},
    "ceilings": {"$ref": "#/$defs/ceilings"},
    "observed_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"},
    "ceilings": {"type": "object", "additionalProperties": false, "required": ["input_bytes", "output_bytes", "runtime_ms", "attempts"], "properties": {"input_bytes": {"const": 4096}, "output_bytes": {"const": 3000}, "runtime_ms": {"const": 800}, "attempts": {"const": 2}}}
  }
}
