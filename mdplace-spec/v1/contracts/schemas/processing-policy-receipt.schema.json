{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:processing-policy-receipt:v1",
  "title": "mdplace Processing Policy decision receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "receipt_id", "scenario_id", "request_id", "request_sha256", "payload_sha256", "consent_binding_id", "consent_binding_sha256", "operation", "decision", "code", "policy_ref", "source_profile_ref", "network_effect", "receipt_sha256"],
  "properties": {
    "schema_id": {"const": "mdplace.processing-policy-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^receipt:cpp-[0-9]{3}$"},
    "scenario_id": {"type": "string", "pattern": "^CPP-[0-9]{3}$"},
    "request_id": {"type": ["string", "null"], "pattern": "^request:[a-z][a-z0-9-]{2,63}$"},
    "request_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "payload_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "consent_binding_id": {"type": ["string", "null"], "pattern": "^consent:[a-z][a-z0-9-]{2,63}$"},
    "consent_binding_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "operation": {"enum": ["processing_decision", "intake_decision", "policy_pair", "recover_binding"]},
    "decision": {"enum": ["allowed", "denied"]},
    "code": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_.]*$"},
    "policy_ref": {"$ref": "#/$defs/policyRef"},
    "source_profile_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/profileRef"}]},
    "network_effect": {"const": "none"},
    "receipt_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policyRef": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_id", "policy_version", "policy_sha256"],
      "properties": {
        "policy_id": {"type": "string", "pattern": "^policy:[a-z][a-z0-9-]{2,63}$"},
        "policy_version": {"$ref": "#/$defs/semver"},
        "policy_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "profileRef": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "profile_version", "profile_sha256"],
      "properties": {
        "profile_id": {"type": "string", "pattern": "^source-profile:[a-z][a-z0-9-]{2,63}$"},
        "profile_version": {"$ref": "#/$defs/semver"},
        "profile_sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
