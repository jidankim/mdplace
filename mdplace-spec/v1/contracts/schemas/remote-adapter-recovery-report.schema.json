{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:remote-adapter-recovery-report:v1",
  "title": "mdplace Remote Intelligence Adapter recovery report",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "report_id", "profile_id", "claim_manifest_sha256", "evidence_digest", "parsed_artifacts_revalidated", "cases", "network_operations", "verdict"],
  "properties": {
    "$schema": {"const": "../../contracts/schemas/remote-adapter-recovery-report.schema.json"},
    "schema_id": {"const": "mdplace.remote-adapter-recovery-report/v1"},
    "report_id": {"const": "remote-adapter-recovery:v1"},
    "profile_id": {"const": "remote-adapter"},
    "claim_manifest_sha256": {"$ref": "#/$defs/digest"},
    "evidence_digest": {"$ref": "#/$defs/digest"},
    "parsed_artifacts_revalidated": {"const": true},
    "cases": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/case"}},
    "network_operations": {"const": 0},
    "verdict": {"enum": ["pass", "fail", "unsupported", "inconclusive"]}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "case": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "scenario_id", "crash_boundary", "claim_manifest_sha256", "evidence_digest", "attempts_revalidated", "claim_digest_revalidated", "parsed_evidence_revalidated", "terminal_state", "receipt_sha256"], "properties": {"fixture_id": {"type": "string", "pattern": "^FIX-RAP-PROFILE-[0-9]{3}$"}, "scenario_id": {"type": "string", "pattern": "^RAP-[0-9]{3}$"}, "crash_boundary": {"enum": ["before_egress", "after_egress"]}, "claim_manifest_sha256": {"$ref": "#/$defs/digest"}, "evidence_digest": {"$ref": "#/$defs/digest"}, "attempts_revalidated": {"type": "boolean"}, "claim_digest_revalidated": {"type": "boolean"}, "parsed_evidence_revalidated": {"type": "boolean"}, "terminal_state": {"enum": ["recovered", "recovery_required", "denied"]}, "receipt_sha256": {"$ref": "#/$defs/digest"}}}
  }
}
