{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:intelligence-adapter-scenario:v1",
  "title": "mdplace Intelligence Adapter protocol conformance scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario_id", "case_id", "operation", "authorization_ref", "chain_budget", "attempts", "recovery", "illegal_transition"],
  "properties": {
    "scenario_id": {"type": "string", "pattern": "^IAP-[0-9]{3}$"}, "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"},
    "operation": {"enum": ["execute", "recover", "observe_illegal_transition"]}, "authorization_ref": {"const": "contracts/intelligence-adapter/approved-context.json"},
    "chain_budget": {"$ref": "#/$defs/budget"}, "attempts": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/attempt"}},
    "recovery": {"$ref": "#/$defs/recovery"}, "illegal_transition": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/illegalTransition"}]}
  },
  "allOf": [
    {"if": {"properties": {"operation": {"const": "execute"}}}, "then": {"properties": {"attempts": {"$ref": "#/$defs/nonCrashAttempts"}, "recovery": {"properties": {"crash_point": {"const": "none"}}}, "illegal_transition": {"type": "null"}}}},
    {"if": {"properties": {"operation": {"const": "recover"}}}, "then": {"properties": {"recovery": {"properties": {"crash_point": {"enum": ["before_transmission", "after_transmission_before_receipt", "after_receipt"]}}}, "illegal_transition": {"type": "null"}}}},
    {"if": {"properties": {"operation": {"const": "recover"}, "recovery": {"properties": {"crash_point": {"const": "before_transmission"}}}}}, "then": {"properties": {"attempts": {"$ref": "#/$defs/beforeTransmissionAttempts"}}}},
    {"if": {"properties": {"operation": {"const": "recover"}, "recovery": {"properties": {"crash_point": {"const": "after_transmission_before_receipt"}}}}}, "then": {"properties": {"attempts": {"$ref": "#/$defs/afterTransmissionAttempts"}}}},
    {"if": {"properties": {"operation": {"const": "recover"}, "recovery": {"properties": {"crash_point": {"const": "after_receipt"}}}}}, "then": {"properties": {"attempts": {"$ref": "#/$defs/nonCrashAttempts"}}}},
    {"if": {"properties": {"operation": {"const": "observe_illegal_transition"}}}, "then": {"properties": {"recovery": {"properties": {"crash_point": {"const": "none"}}}, "illegal_transition": {"$ref": "#/$defs/illegalTransition"}}}}
  ],
  "$defs": {
    "budget": {"type": "object", "additionalProperties": false, "required": ["max_attempts", "max_retries", "max_fallbacks", "input_bytes", "output_bytes", "runtime_ms", "cost_microunits"], "properties": {"max_attempts": {"type": "integer", "minimum": 1, "maximum": 3}, "max_retries": {"type": "integer", "minimum": 0, "maximum": 1}, "max_fallbacks": {"type": "integer", "minimum": 0, "maximum": 1}, "input_bytes": {"type": "integer", "minimum": 1}, "output_bytes": {"type": "integer", "minimum": 1}, "runtime_ms": {"type": "integer", "minimum": 1}, "cost_microunits": {"type": "integer", "minimum": 0}}},
    "attempt": {"type": "object", "additionalProperties": false, "required": ["attempt_class", "envelope", "isolation", "double"], "properties": {"attempt_class": {"enum": ["primary", "retry", "fallback"]}, "envelope": {"description": "Closed Processing Envelope validated separately against processing-envelope.schema.json."}, "isolation": {"$ref": "#/$defs/isolation"}, "double": {"$ref": "#/$defs/double"}}},
    "nonCrashAttempts": {"type": "array", "items": {"properties": {"double": {"properties": {"behavior": {"enum": ["proposal", "transient_failure", "timeout", "malformed_output"]}}}}}},
    "beforeTransmissionAttempts": {"type": "array", "prefixItems": [{"properties": {"double": {"properties": {"behavior": {"const": "crash_before_transmit"}}}}}]},
    "afterTransmissionAttempts": {"type": "array", "prefixItems": [{"properties": {"double": {"properties": {"behavior": {"const": "crash_after_transmit"}}}}}]},
    "isolation": {"type": "object", "additionalProperties": false, "required": ["ephemeral", "fresh_process", "filesystem", "tools", "ambient_configuration", "credential_visibility", "network_scope", "effective_capabilities", "canary"], "properties": {"ephemeral": {"type": "boolean"}, "fresh_process": {"type": "boolean"}, "filesystem": {"enum": ["none", "present"]}, "tools": {"enum": ["none", "present"]}, "ambient_configuration": {"enum": ["unreadable", "readable"]}, "credential_visibility": {"enum": ["none", "visible"]}, "network_scope": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "effective_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "canary": {"$ref": "#/$defs/canary"}}},
    "canary": {"type": "object", "additionalProperties": false, "required": ["canary_id", "challenge", "expected", "observed", "passed"], "properties": {"canary_id": {"type": "string", "pattern": "^canary:[a-z0-9-]{3,64}$"}, "challenge": {"type": "string", "minLength": 1}, "expected": {"type": "string", "minLength": 1}, "observed": {"type": "string"}, "passed": {"type": "boolean"}}},
    "double": {"type": "object", "additionalProperties": false, "required": ["behavior", "raw_output", "duration_ms", "cost_microunits", "observed_started_at", "observed_completed_at", "provider_request_id", "requested_actions"], "properties": {"behavior": {"enum": ["proposal", "transient_failure", "timeout", "malformed_output", "crash_before_transmit", "crash_after_transmit"]}, "raw_output": {"type": ["string", "null"]}, "duration_ms": {"type": "integer", "minimum": 0}, "cost_microunits": {"type": "integer", "minimum": 0}, "observed_started_at": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"}, "observed_completed_at": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"}, "provider_request_id": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^provider-request:[a-z0-9-]{3,80}$"}]}, "requested_actions": {"type": "array", "uniqueItems": true, "items": {"enum": ["invoke_tool", "request_secret", "read_ambient_config", "write_file", "establish_semantic_truth", "choose_note_placement"]}}}},
    "recovery": {"type": "object", "additionalProperties": false, "required": ["crash_point", "transmission_observed", "prior_transmission", "prior_receipts"], "properties": {"crash_point": {"enum": ["none", "before_transmission", "after_transmission_before_receipt", "after_receipt"]}, "transmission_observed": {"type": "boolean"}, "prior_transmission": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/transmission"}]}, "prior_receipts": {"type": "array", "maxItems": 1, "items": {"description": "Closed Adapter Run Receipt validated separately against adapter-run-receipt.schema.json."}}}},
    "transmission": {"type": "object", "additionalProperties": false, "required": ["destination", "sha256", "byte_length"], "properties": {"destination": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "byte_length": {"type": "integer", "minimum": 1}}},
    "illegalTransition": {"type": "object", "additionalProperties": false, "required": ["table", "from_state", "command"], "properties": {"table": {"type": "string", "pattern": "^contracts/transitions/intelligence-adapter-[a-z-]+\\.json$"}, "from_state": {"type": "string", "minLength": 1}, "command": {"type": "string", "minLength": 1}}}
  }
}
