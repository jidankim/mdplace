{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:child-work-invocation:v1",
  "title": "mdplace isolated disposable Child Work Invocation",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "invocation_id", "work_binding", "processing_envelope", "scratch_boundary", "credential_reference", "endpoint_allowlist", "budgets", "capabilities", "output", "completion_receipt", "process_lifecycle"],
  "properties": {
    "$schema": {"const": "../schemas/child-work-invocation.schema.json"},
    "schema_id": {"const": "mdplace.child-work-invocation/v1"},
    "invocation_id": {"type": "string", "pattern": "^child-invocation:[a-z0-9-]{3,64}$"},
    "work_binding": {"$ref": "#/$defs/workBinding"},
    "processing_envelope": {"$ref": "#/$defs/processingEnvelope"},
    "scratch_boundary": {"$ref": "#/$defs/scratchBoundary"},
    "credential_reference": {"$ref": "#/$defs/credentialReference"},
    "endpoint_allowlist": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^https://[a-z0-9.-]{3,128}/[a-zA-Z0-9._~/-]*$"}},
    "budgets": {"$ref": "#/$defs/budgets"},
    "capabilities": {"$ref": "#/$defs/capabilities"},
    "output": {"$ref": "#/$defs/output"},
    "completion_receipt": {"$ref": "#/$defs/completionReceipt"},
    "process_lifecycle": {"const": "fresh_process_destroyed_after_receipt"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "workBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persistent_agent_id", "work_id", "work_version", "lease_id", "journal_head_sequence"],
      "properties": {
        "persistent_agent_id": {"type": "string", "pattern": "^agent:[a-z0-9-]{3,64}$"},
        "work_id": {"type": "string", "pattern": "^work:[a-z0-9-]{3,64}$"},
        "work_version": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "lease_id": {"type": "string", "pattern": "^lease:[a-z0-9-]{3,64}$"},
        "journal_head_sequence": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }
    },
    "processingEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "input_digest", "processing_policy_version", "processing_policy_digest"],
      "properties": {
        "schema_id": {"type": "string", "pattern": "^mdplace\\.[a-z0-9.-]+/v[1-9][0-9]*$"},
        "input_digest": {"$ref": "#/$defs/digest"},
        "processing_policy_version": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "processing_policy_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "scratchBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "max_bytes", "cleanup"],
      "properties": {
        "path": {"type": "string", "pattern": "^scratch/[a-z0-9-]{3,64}$"},
        "max_bytes": {"type": "integer", "minimum": 1, "maximum": 10485760},
        "cleanup": {"const": "destroy_after_invocation"}
      }
    },
    "credentialReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_id", "material_exposed"],
      "properties": {
        "reference_id": {"type": "string", "pattern": "^credential-ref:[a-z0-9-]{3,64}$"},
        "material_exposed": {"const": false}
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_time_ms", "max_input_bytes", "max_output_bytes", "max_network_requests"],
      "properties": {
        "wall_time_ms": {"type": "integer", "minimum": 1, "maximum": 900000},
        "max_input_bytes": {"type": "integer", "minimum": 1, "maximum": 10485760},
        "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 10485760},
        "max_network_requests": {"type": "integer", "minimum": 0, "maximum": 32}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vault_read", "vault_write", "shell", "arbitrary_network", "semantic_append", "vault_mutation"],
      "properties": {
        "vault_read": {"const": false},
        "vault_write": {"const": false},
        "shell": {"const": false},
        "arbitrary_network": {"const": false},
        "semantic_append": {"const": false},
        "vault_mutation": {"const": false}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_valid", "output_digest", "semantic_authority"],
      "properties": {
        "schema_id": {"type": "string", "pattern": "^mdplace\\.[a-z0-9.-]+/v[1-9][0-9]*$"},
        "schema_valid": {"const": true},
        "output_digest": {"$ref": "#/$defs/digest"},
        "semantic_authority": {"const": "none"}
      }
    },
    "completionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "invocation_id", "work_id", "work_version", "lease_id", "journal_head_sequence", "output_digest", "signature_scheme", "signing_key_id", "signer_agent_id", "signature_digest", "authenticated"],
      "properties": {
        "receipt_id": {"type": "string", "pattern": "^child-receipt:[a-z0-9-]{3,64}$"},
        "invocation_id": {"type": "string", "pattern": "^child-invocation:[a-z0-9-]{3,64}$"},
        "work_id": {"type": "string", "pattern": "^work:[a-z0-9-]{3,64}$"},
        "work_version": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "lease_id": {"type": "string", "pattern": "^lease:[a-z0-9-]{3,64}$"},
        "journal_head_sequence": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "output_digest": {"$ref": "#/$defs/digest"},
        "signature_scheme": {"const": "hmac-sha256"},
        "signing_key_id": {"const": "signer-key:primary-001"},
        "signer_agent_id": {"type": "string", "pattern": "^agent:[a-z0-9-]{3,64}$"},
        "signature_digest": {"$ref": "#/$defs/digest"},
        "authenticated": {"const": true}
      }
    }
  }
}
