{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:local-adapter-scenario:v1",
  "title": "mdplace Local Intelligence Adapter conformance scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "scenario_id", "case_id", "operation", "evaluated_at", "processing_envelope_json", "processing_envelope_sha256", "capability_evidence_json", "capability_evidence_sha256", "isolation_evidence_json", "isolation_evidence_sha256", "attempt_observation_json", "attempt_observation_sha256", "instruction_kind", "claimed_authority", "behavior", "output_bytes", "runtime_ms", "attempts", "ceilings", "raw_output", "recovery_binding", "transition_ref"],
  "properties": {
    "schema_id": {"const": "mdplace.local-adapter-scenario/v1"},
    "scenario_id": {"type": "string", "pattern": "^LIA-[0-9]{3}$"},
    "case_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,80}$"},
    "operation": {"enum": ["execute", "cancel", "resume", "recover", "transition"]},
    "evaluated_at": {"const": "2026-08-22T00:00:00.000Z"},
    "processing_envelope_json": {"type": "string", "minLength": 1, "maxLength": 8192},
    "processing_envelope_sha256": {"$ref": "#/$defs/digest"},
    "capability_evidence_json": {"type": ["string", "null"]},
    "capability_evidence_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "isolation_evidence_json": {"type": ["string", "null"]},
    "isolation_evidence_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "attempt_observation_json": {"type": "string", "minLength": 1},
    "attempt_observation_sha256": {"$ref": "#/$defs/digest"},
    "instruction_kind": {"enum": ["ordinary", "hostile", "embedded_tool", "secret_request", "ambient_configuration"]},
    "claimed_authority": {"enum": ["none", "semantic", "note_placement", "taxonomy", "projection", "filesystem", "network", "tool", "automation"]},
    "behavior": {"enum": ["complete", "malformed_output", "interrupt", "cancelled", "resumed", "repeated_interruption", "hung", "flaky", "misleading_success", "crash_before_receipt", "crash_after_receipt"]},
    "output_bytes": {"type": "integer", "minimum": 0},
    "runtime_ms": {"type": "integer", "minimum": 0},
    "attempts": {"type": "integer", "minimum": 0},
    "ceilings": {"$ref": "#/$defs/ceilings"},
    "raw_output": {"type": ["string", "null"]},
    "recovery_binding": {"enum": ["none", "current", "stale_claim", "stale_evidence"]},
    "transition_ref": {"type": ["string", "null"], "pattern": "^contracts/transitions/local-adapter-[a-z-]{1,32}-lifecycle\\.json#[a-z_]{1,32}:[a-z_]{1,32}$"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ceilings": {"type": "object", "additionalProperties": false, "required": ["input_bytes", "output_bytes", "runtime_ms", "attempts"], "properties": {"input_bytes": {"const": 4096}, "output_bytes": {"const": 3000}, "runtime_ms": {"const": 800}, "attempts": {"const": 2}}}
  }
}
