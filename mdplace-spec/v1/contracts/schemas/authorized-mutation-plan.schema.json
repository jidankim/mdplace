{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:authorized-mutation-plan:v1",
  "title": "mdplace Authorized Mutation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "plan_id", "plan_version", "vault_id", "trusted_root_id", "operation", "caller", "ownership", "source_components", "target_components", "immutable_inputs", "expected_precondition", "expected_result", "placement_outcome_ref", "durability_policy", "idempotency_key", "recovery_intent", "plan_state"],
  "properties": {
    "$schema": {"const": "../schemas/authorized-mutation-plan.schema.json"},
    "schema_id": {"const": "mdplace.authorized-mutation-plan/v1"},
    "plan_id": {"type": "string", "pattern": "^mutation-plan:[a-z0-9-]{3,64}$"},
    "plan_version": {"type": "integer", "minimum": 1},
    "vault_id": {"type": "string", "pattern": "^vault:[a-z0-9-]{3,64}$"},
    "trusted_root_id": {"type": "string", "pattern": "^trusted-root:[a-z0-9-]{3,64}$"},
    "operation": {"enum": ["promote_capture", "move_projection", "create_directory", "remove_empty_owned_directory", "write_managed_frontmatter"]},
    "caller": {"$ref": "#/$defs/caller"},
    "ownership": {"$ref": "#/$defs/ownership"},
    "source_components": {"$ref": "#/$defs/components"},
    "target_components": {"$ref": "#/$defs/components"},
    "immutable_inputs": {"$ref": "#/$defs/immutableInputs"},
    "expected_precondition": {"$ref": "#/$defs/descriptorIdentity"},
    "expected_result": {"$ref": "#/$defs/descriptorIdentity"},
    "placement_outcome_ref": {"type": ["string", "null"], "pattern": "^placement:[a-z0-9-]{3,64}$"},
    "durability_policy": {"const": "sync_journal_data_metadata_receipt_readback_commit"},
    "idempotency_key": {"type": "string", "pattern": "^vmg-idem:[a-z0-9-]{3,64}$"},
    "recovery_intent": {"enum": ["resume", "exact_rollback", "compensate", "terminal_manual_repair"]},
    "plan_state": {"const": "authorized"}
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "promote_capture"}}},
      "then": {"properties": {"caller": {"properties": {"role": {"const": "capture_adapter"}}}}}
    },
    {
      "if": {"properties": {"caller": {"properties": {"role": {"const": "capture_adapter"}}}}},
      "then": {"properties": {"operation": {"const": "promote_capture"}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "components": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]{1,255}$"}},
    "caller": {
      "type": "object", "additionalProperties": false,
      "required": ["caller_id", "role", "authority_receipt_sha256"],
      "properties": {
        "caller_id": {"type": "string", "pattern": "^(capture-adapter|folder-projection|foreground-recovery):[a-z0-9-]{3,64}$"},
        "role": {"enum": ["capture_adapter", "folder_projection", "foreground_recovery"]},
        "authority_receipt_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "ownership": {
      "type": "object", "additionalProperties": false,
      "required": ["agent_id", "exclusive_writer_receipt_sha256", "writer_epoch"],
      "properties": {
        "agent_id": {"type": "string", "pattern": "^agent:[a-z0-9-]{3,64}$"},
        "exclusive_writer_receipt_sha256": {"$ref": "#/$defs/digest"},
        "writer_epoch": {"type": "integer", "minimum": 1}
      }
    },
    "immutableInputs": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_sha256", "source_sha256", "target_sha256", "policy_sha256", "semantic_base_sha256"],
      "properties": {
        "plan_sha256": {"$ref": "#/$defs/digest"},
        "source_sha256": {"$ref": "#/$defs/digest"},
        "target_sha256": {"$ref": "#/$defs/digest"},
        "policy_sha256": {"$ref": "#/$defs/digest"},
        "semantic_base_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "descriptorIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["device", "inode", "size", "content_sha256"],
      "properties": {
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 1},
        "size": {"type": "integer", "minimum": 0},
        "content_sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
