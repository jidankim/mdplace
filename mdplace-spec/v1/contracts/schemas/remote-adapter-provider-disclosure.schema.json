{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:remote-adapter-provider-disclosure:v1",
  "title": "mdplace Remote Intelligence Adapter provider disclosure",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "disclosure_id", "provider_id", "destination", "fact", "observed_at", "expires_at"],
  "properties": {
    "$schema": {"const": "../../contracts/schemas/remote-adapter-provider-disclosure.schema.json"},
    "schema_id": {"const": "mdplace.remote-adapter-provider-disclosure/v1"},
    "disclosure_id": {"const": "remote-provider-disclosure:remote-alpha:v1"},
    "provider_id": {"const": "provider:remote-alpha"},
    "destination": {"const": "https://api.remote-alpha.test/v1/process"},
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "status", "value"],
      "properties": {
        "dimension": {"const": "retention"},
        "status": {"const": "disclosed"},
        "value": {"type": "string", "pattern": "^maximum [1-9][0-9]* days$", "maxLength": 32}
      }
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
