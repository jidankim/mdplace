{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:semantic-kernel-scenario:v1",
  "title": "mdplace Semantic Kernel stateful conformance scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "scenario_id", "initial", "action"],
  "properties": {
    "schema_id": {"const": "mdplace.semantic-kernel-scenario/v1"},
    "scenario_id": {"type": "string", "pattern": "^SK-[0-9]{3}$"},
    "initial": {"$ref": "#/$defs/initial"},
    "action": {"$ref": "#/$defs/action"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stateEntry": {
      "type": "object", "additionalProperties": false, "required": ["key", "value"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9/._-]{1,127}$"},
        "value": {"type": "string", "maxLength": 1024}
      }
    },
    "head": {
      "type": "object", "additionalProperties": false, "required": ["sequence", "operation_id"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "operation_id": {"type": ["string", "null"], "pattern": "^operation:[a-z0-9][a-z0-9-]{2,63}$"}
      }
    },
    "priorReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["idempotency_key", "command_digest", "operation_id", "receipt_id"],
      "properties": {
        "idempotency_key": {"type": "string", "pattern": "^idempotency:[a-z0-9][a-z0-9-]{2,63}$"},
        "command_digest": {"$ref": "#/$defs/digest"},
        "operation_id": {"type": "string", "pattern": "^operation:[a-z0-9][a-z0-9-]{2,63}$"},
        "receipt_id": {"type": "string", "pattern": "^receipt:[a-z0-9][a-z0-9-]{2,63}$"}
      }
    },
    "historyEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "operation_id", "operation_digest", "idempotency_key", "command_digest"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "operation_id": {"type": "string", "pattern": "^operation:[a-z0-9][a-z0-9-]{2,63}$"},
        "operation_digest": {"$ref": "#/$defs/digest"},
        "idempotency_key": {"type": "string", "pattern": "^idempotency:[a-z0-9][a-z0-9-]{2,63}$"},
        "command_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "initial": {
      "type": "object", "additionalProperties": false,
      "required": ["lifecycle_state", "head", "semantic_state", "bound_inputs", "prior_receipts"],
      "properties": {
        "lifecycle_state": {"enum": ["ready", "recovery_required"]},
        "head": {"$ref": "#/$defs/head"},
        "semantic_state": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/stateEntry"}},
        "bound_inputs": {"type": "array", "maxItems": 15, "items": {"$ref": "#/$defs/boundInputValue"}},
        "prior_receipts": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/priorReceipt"}}
      }
    },
    "actor": {
      "type": "object", "additionalProperties": false, "required": ["actor_id", "actor_kind", "authority_ref"],
      "properties": {
        "actor_id": {"type": "string", "pattern": "^(person|component):[a-z0-9][a-z0-9-]{2,63}$"},
        "actor_kind": {"enum": ["vault_owner", "mdplace_agent", "foreground_recovery", "capture_adapter", "intelligence_adapter", "folder_projection", "projection", "frontmatter_bridge", "cache"]},
        "authority_ref": {"type": "string", "pattern": "^authority:[a-z0-9][a-z0-9-]{2,63}$"}
      }
    },
    "semanticHead": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "kind", "sequence", "operation_id", "state_digest"],
      "properties": {
        "ordinal": {"const": 0}, "kind": {"const": "semantic_head"},
        "sequence": {"type": "integer", "minimum": 0},
        "operation_id": {"type": ["string", "null"], "pattern": "^operation:[a-z0-9][a-z0-9-]{2,63}$"},
        "state_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "boundInput": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "kind", "ref_id", "digest"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 15}, "kind": {"const": "bound_input"},
        "ref_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}:[a-z0-9][a-z0-9-]{2,63}$"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "boundInputValue": {
      "type": "object", "additionalProperties": false, "required": ["ref_id", "digest"],
      "properties": {
        "ref_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}:[a-z0-9][a-z0-9-]{2,63}$"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "baseReference": {"oneOf": [{"$ref": "#/$defs/semanticHead"}, {"$ref": "#/$defs/boundInput"}]},
    "ordering": {"oneOf": [{"$ref": "#/$defs/orderingObject"}, {"type": "null"}]},
    "orderingObject": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "predecessor_operation_id", "sort_key"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "predecessor_operation_id": {"type": ["string", "null"], "pattern": "^operation:[a-z0-9][a-z0-9-]{2,63}$"},
        "sort_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9:-]{2,127}$"}
      }
    },
    "eventPayload": {
      "type": "object", "additionalProperties": false, "required": ["key", "value"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9/._-]{1,127}$"},
        "value": {"type": ["string", "null"], "maxLength": 1024}
      }
    },
    "assignmentEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "ordinal", "event_kind", "schema_version", "payload"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^event:[a-z0-9][a-z0-9-]{2,63}$"},
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 31},
        "event_kind": {"const": "semantic_assignment"},
        "schema_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "payload": {
          "type": "object", "additionalProperties": false, "required": ["key", "value"],
          "properties": {
            "key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9/._-]{1,127}$"},
            "value": {"type": "string", "maxLength": 1024}
          }
        }
      }
    },
    "removalEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "ordinal", "event_kind", "schema_version", "payload"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^event:[a-z0-9][a-z0-9-]{2,63}$"},
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 31},
        "event_kind": {"const": "semantic_removal"},
        "schema_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "payload": {
          "type": "object", "additionalProperties": false, "required": ["key", "value"],
          "properties": {
            "key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9/._-]{1,127}$"},
            "value": {"const": null}
          }
        }
      }
    },
    "markerEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "ordinal", "event_kind", "schema_version", "payload"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^event:[a-z0-9][a-z0-9-]{2,63}$"},
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 31},
        "event_kind": {"const": "compatibility_marker"},
        "schema_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "payload": {
          "type": "object", "additionalProperties": false, "required": ["key", "value"],
          "properties": {
            "key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9/._-]{1,127}$"},
            "value": {"const": null}
          }
        }
      }
    },
    "futureEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "ordinal", "event_kind", "schema_version", "payload"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^event:[a-z0-9][a-z0-9-]{2,63}$"},
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 31},
        "event_kind": {"type": "string", "pattern": "^future_[a-z0-9_]{2,56}$"},
        "schema_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "payload": {"$ref": "#/$defs/eventPayload"}
      }
    },
    "assignmentEventList": {"type": "object", "additionalProperties": false, "required": ["events"], "properties": {"events": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/assignmentEvent"}}}},
    "removalEventList": {"type": "object", "additionalProperties": false, "required": ["events"], "properties": {"events": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/removalEvent"}}}},
    "markerEventList": {"type": "object", "additionalProperties": false, "required": ["events"], "properties": {"events": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/markerEvent"}}}},
    "futureEventList": {"type": "object", "additionalProperties": false, "required": ["events"], "properties": {"events": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/futureEvent"}}}},
    "eventList": {"oneOf": [{"$ref": "#/$defs/assignmentEventList"}, {"$ref": "#/$defs/removalEventList"}, {"$ref": "#/$defs/markerEventList"}, {"$ref": "#/$defs/futureEventList"}]},
    "payload": {"oneOf": [{"$ref": "#/$defs/eventList"}, {"type": "null"}]},
    "precondition": {
      "type": "object", "additionalProperties": false, "required": ["ordinal", "kind", "key", "expected_value"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 31}, "kind": {"const": "semantic_value"},
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9/._-]{1,127}$"},
        "expected_value": {"type": ["string", "null"], "maxLength": 1024}
      }
    },
    "snapshot": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["sequence", "operation_id", "state_digest", "semantic_state", "history", "history_digest"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "operation_id": {"type": ["string", "null"], "pattern": "^operation:[a-z0-9][a-z0-9-]{2,63}$"},
        "state_digest": {"$ref": "#/$defs/digest"},
        "semantic_state": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/stateEntry"}},
        "history": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/historyEntry"}},
        "history_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "actor", "command_id", "operation_id", "operation_kind", "base_references", "ordering", "idempotency_key", "command_digest", "payload", "preconditions", "records", "snapshot", "supplied_view", "crash_point", "recovery_id"],
      "properties": {
        "kind": {"enum": ["append", "replay", "rebuild_view", "recover"]},
        "actor": {"$ref": "#/$defs/actor"},
        "command_id": {"type": ["string", "null"], "pattern": "^command:[a-z0-9][a-z0-9-]{2,63}$"},
        "operation_id": {"type": ["string", "null"], "pattern": "^operation:[a-z0-9][a-z0-9-]{2,63}$"},
        "operation_kind": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "base_references": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/baseReference"}},
        "ordering": {"$ref": "#/$defs/ordering"},
        "idempotency_key": {"type": ["string", "null"], "pattern": "^idempotency:[a-z0-9][a-z0-9-]{2,63}$"},
        "command_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "payload": {"$ref": "#/$defs/payload"},
        "preconditions": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/precondition"}},
        "records": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 32768}},
        "snapshot": {"$ref": "#/$defs/snapshot"},
        "supplied_view": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/stateEntry"}},
        "crash_point": {"enum": [null, "before_record_publish", "after_record_publish_before_receipt"]},
        "recovery_id": {"type": ["string", "null"], "pattern": "^recovery:[a-z0-9][a-z0-9-]{2,63}$"}
      },
      "oneOf": [
        {
          "properties": {
            "kind": {"const": "append"},
            "command_id": {"type": "string"}, "operation_id": {"type": "string"},
            "operation_kind": {"type": "string"}, "base_references": {"minItems": 1},
            "ordering": {"$ref": "#/$defs/orderingObject"}, "idempotency_key": {"type": "string"},
            "command_digest": {"type": "string"}, "payload": {"$ref": "#/$defs/eventList"},
            "records": {"maxItems": 0}, "snapshot": {"const": null},
            "supplied_view": {"maxItems": 0}, "crash_point": {"const": null}, "recovery_id": {"const": null}
          },
          "oneOf": [
            {"properties": {"operation_kind": {"const": "semantic_assignment"}, "payload": {"$ref": "#/$defs/assignmentEventList"}}},
            {"properties": {"operation_kind": {"const": "semantic_removal"}, "payload": {"$ref": "#/$defs/removalEventList"}}},
            {"properties": {"operation_kind": {"const": "compatibility_marker"}, "payload": {"$ref": "#/$defs/markerEventList"}}},
            {"properties": {"operation_kind": {"type": "string", "pattern": "^future_[a-z0-9_]{2,56}$"}, "payload": {"$ref": "#/$defs/futureEventList"}}}
          ]
        },
        {
          "properties": {
            "kind": {"const": "replay"},
            "command_id": {"const": null}, "operation_id": {"const": null},
            "operation_kind": {"const": null}, "base_references": {"maxItems": 0},
            "ordering": {"const": null}, "idempotency_key": {"const": null},
            "command_digest": {"const": null}, "payload": {"const": null},
            "preconditions": {"maxItems": 0}, "records": {"minItems": 1},
            "supplied_view": {"maxItems": 0}, "crash_point": {"const": null}, "recovery_id": {"const": null}
          }
        },
        {
          "properties": {
            "kind": {"const": "rebuild_view"},
            "command_id": {"const": null}, "operation_id": {"const": null},
            "operation_kind": {"const": null}, "base_references": {"maxItems": 0},
            "ordering": {"const": null}, "idempotency_key": {"const": null},
            "command_digest": {"const": null}, "payload": {"const": null},
            "preconditions": {"maxItems": 0}, "records": {"minItems": 1},
            "crash_point": {"const": null}, "recovery_id": {"const": null}
          }
        },
        {
          "properties": {
            "kind": {"const": "recover"},
            "command_id": {"const": null}, "operation_id": {"const": null},
            "operation_kind": {"const": null}, "base_references": {"maxItems": 0},
            "ordering": {"const": null}, "idempotency_key": {"const": null},
            "command_digest": {"const": null}, "payload": {"const": null},
            "preconditions": {"maxItems": 0}, "records": {"maxItems": 0},
            "snapshot": {"const": null}, "supplied_view": {"maxItems": 0},
            "crash_point": {"const": "before_record_publish"}, "recovery_id": {"type": "string"}
          }
        },
        {
          "properties": {
            "kind": {"const": "recover"},
            "command_id": {"const": null}, "operation_id": {"const": null},
            "operation_kind": {"const": null}, "base_references": {"maxItems": 0},
            "ordering": {"const": null}, "idempotency_key": {"const": null},
            "command_digest": {"const": null}, "payload": {"const": null},
            "preconditions": {"maxItems": 0}, "records": {"minItems": 1, "maxItems": 1},
            "snapshot": {"const": null}, "supplied_view": {"maxItems": 0},
            "crash_point": {"const": "after_record_publish_before_receipt"}, "recovery_id": {"type": "string"}
          }
        }
      ]
    }
  }
}
