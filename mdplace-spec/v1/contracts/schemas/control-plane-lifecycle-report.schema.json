{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:control-plane-lifecycle-report:v1",
  "title": "mdplace supervised Agent lifecycle evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "report_id", "package_series", "persistent_agent_id", "vault_id", "profile_binding", "lifecycle_table_binding", "doctor_report_binding", "vault_owner_recovery_approval", "work_admission_after_approval", "required_same_core_revalidation"],
  "properties": {
    "$schema": {"const": "../../contracts/schemas/control-plane-lifecycle-report.schema.json"},
    "schema_id": {"const": "mdplace.control-plane-lifecycle-report/v1"},
    "report_id": {"type": "string", "pattern": "^control-plane-lifecycle-report:[a-z0-9-]{3,64}$"},
    "package_series": {"const": "mdplace-spec/v1"},
    "persistent_agent_id": {"type": "string", "pattern": "^agent:[a-z0-9-]{3,64}$"},
    "vault_id": {"type": "string", "pattern": "^vault:[a-z0-9-]{3,64}$"},
    "profile_binding": {"$ref": "#/$defs/profileBinding"},
    "lifecycle_table_binding": {"$ref": "#/$defs/lifecycleTableBinding"},
    "doctor_report_binding": {"$ref": "#/$defs/doctorReportBinding"},
    "vault_owner_recovery_approval": {"$ref": "#/$defs/vaultOwnerRecoveryApprovalReceipt"},
    "work_admission_after_approval": {"const": "diagnostic_only"},
    "required_same_core_revalidation": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "prefixItems": [
        {"const": "exclusive_writer"},
        {"const": "readiness_gate_chain"},
        {"const": "wake_revalidation"}
      ],
      "items": false
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "profileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "contracts/control-plane/launchagent-supervision-profile.json"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "lifecycleTableBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "contracts/transitions/launchagent-supervision-lifecycle.json"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "doctorReportBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_id", "path", "sha256", "circuit_version"],
      "properties": {
        "report_id": {"type": "string", "pattern": "^control-plane-doctor-report:[a-z0-9-]{3,64}$"},
        "path": {"const": "conformance/evidence/control-plane-doctor-report.json"},
        "sha256": {"$ref": "#/$defs/digest"},
        "circuit_version": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }
    },
    "vaultOwnerRecoveryApprovalReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "principal_id", "vault_id", "persistent_agent_id", "doctor_report_id", "doctor_report_digest", "circuit_version", "selected_action", "idempotency_key", "signature_scheme", "signing_key_id", "signer_principal_id", "signature_digest", "authenticated"],
      "properties": {
        "receipt_id": {"type": "string", "pattern": "^vault-owner-recovery-approval:[a-z0-9-]{3,64}$"},
        "principal_id": {"const": "person:owner-001"},
        "vault_id": {"type": "string", "pattern": "^vault:[a-z0-9-]{3,64}$"},
        "persistent_agent_id": {"type": "string", "pattern": "^agent:[a-z0-9-]{3,64}$"},
        "doctor_report_id": {"type": "string", "pattern": "^control-plane-doctor-report:[a-z0-9-]{3,64}$"},
        "doctor_report_digest": {"$ref": "#/$defs/digest"},
        "circuit_version": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "selected_action": {"const": "revalidate_same_agent_core"},
        "idempotency_key": {"type": "string", "pattern": "^idempotency:[a-z0-9-]{3,64}$"},
        "signature_scheme": {"const": "hmac-sha256"},
        "signing_key_id": {"const": "signer-key:vault-owner-001"},
        "signer_principal_id": {"const": "person:owner-001"},
        "signature_digest": {"$ref": "#/$defs/digest"},
        "authenticated": {"const": true}
      }
    }
  }
}
