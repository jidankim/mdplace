{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:semantic-kernel-recovery-report:v1",
  "title": "mdplace Semantic Kernel result-bound recovery and equivalence evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "package_series", "release_version", "validator_version", "scenario_count", "scenario_ids", "fixture_bindings", "claims"],
  "properties": {
    "$schema": {"const": "../../contracts/schemas/semantic-kernel-recovery-report.schema.json"},
    "schema_id": {"const": "mdplace.semantic-kernel-recovery-report/v1"},
    "package_series": {"const": "mdplace-spec/v1"},
    "release_version": {"const": "1.0.0"},
    "validator_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "scenario_count": {"const": 30},
    "scenario_ids": {"type": "array", "minItems": 30, "maxItems": 30, "uniqueItems": true, "items": {"$ref": "#/$defs/fixtureId"}},
    "fixture_bindings": {"type": "array", "minItems": 30, "maxItems": 30, "items": {"$ref": "#/$defs/fixtureBinding"}},
    "claims": {"$ref": "#/$defs/claims"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fixtureId": {"type": "string", "pattern": "^FIX-SK-[A-Z][A-Z0-9_]{1,31}-[0-9]{3}$"},
    "fixtureBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["fixture_id", "path", "fixture_sha256", "observable_result_sha256"],
      "properties": {
        "fixture_id": {"$ref": "#/$defs/fixtureId"},
        "path": {"type": "string", "pattern": "^scenarios/semantic-kernel/[a-z0-9][a-z0-9-]*\\.json$"},
        "fixture_sha256": {"$ref": "#/$defs/digest"},
        "observable_result_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "fixtureIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/fixtureId"}},
    "digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["replay_snapshot_equivalence", "rebuild_deterministic", "crash_recovery", "semantic_write_denials"],
      "properties": {
        "replay_snapshot_equivalence": {
          "type": "object", "additionalProperties": false,
          "required": ["fixture_ids", "semantic_state_sha256"],
          "properties": {"fixture_ids": {"$ref": "#/$defs/fixtureIds", "minItems": 2, "maxItems": 2}, "semantic_state_sha256": {"$ref": "#/$defs/digest"}}
        },
        "rebuild_deterministic": {
          "type": "object", "additionalProperties": false,
          "required": ["fixture_id", "observable_result_sha256"],
          "properties": {"fixture_id": {"$ref": "#/$defs/fixtureId"}, "observable_result_sha256": {"$ref": "#/$defs/digest"}}
        },
        "crash_recovery": {
          "type": "object", "additionalProperties": false,
          "required": ["fixture_ids", "observable_result_sha256"],
          "properties": {"fixture_ids": {"$ref": "#/$defs/fixtureIds", "minItems": 2, "maxItems": 2}, "observable_result_sha256": {"$ref": "#/$defs/digests", "minItems": 2, "maxItems": 2}}
        },
        "semantic_write_denials": {
          "type": "object", "additionalProperties": false,
          "required": ["fixture_ids", "observable_result_sha256"],
          "properties": {"fixture_ids": {"$ref": "#/$defs/fixtureIds", "minItems": 6, "maxItems": 6}, "observable_result_sha256": {"$ref": "#/$defs/digests", "minItems": 6, "maxItems": 6}}
        }
      }
    }
  }
}
