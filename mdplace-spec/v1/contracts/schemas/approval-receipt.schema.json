{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:approval-receipt:v1",
  "title": "mdplace vault-owner approval receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "receipt_id", "subject_kind", "subject_id", "subject_version", "vault_id", "subject_payload_sha256", "approved", "principal_id", "role", "delegated", "receipt_sha256"],
  "properties": {
    "$schema": {"const": "contracts/schemas/approval-receipt.schema.json"},
    "schema_id": {"const": "mdplace.approval-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^approval:[a-z][a-z0-9-]{2,63}$"},
    "subject_kind": {"enum": ["processing_policy", "source_profile"]},
    "subject_id": {"type": "string", "pattern": "^(policy|source-profile):[a-z][a-z0-9-]{2,63}$"},
    "subject_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "vault_id": {"type": "string", "pattern": "^vault:[a-z][a-z0-9-]{2,63}$"},
    "subject_payload_sha256": {"$ref": "#/$defs/digest"},
    "approved": {"type": "boolean"},
    "principal_id": {"type": "string", "pattern": "^person:[a-z][a-z0-9-]{2,63}$"},
    "role": {"enum": ["vault_owner", "capture_adapter", "compatibility_claim"]},
    "delegated": {"type": "boolean"},
    "receipt_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
