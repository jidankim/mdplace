{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:remote-adapter-credential-boundary-evidence:v1",
  "title": "mdplace Remote Intelligence Adapter credential-boundary evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "profile_id", "evidence_id", "status", "profile_sha256", "boundary_id", "provider_id", "store", "authentication_method", "prerequisite", "adapter_visibility", "secret_access", "ambient_configuration", "environment_values", "claims_established", "observed_at", "expires_at"],
  "properties": {
    "$schema": {"const": "../schemas/remote-adapter-credential-boundary-evidence.schema.json"},
    "schema_id": {"const": "mdplace.remote-adapter-credential-boundary-evidence/v1"},
    "profile_id": {"const": "remote-adapter"},
    "evidence_id": {"const": "remote-credential-boundary:v1"},
    "status": {"enum": ["current", "stale", "unsupported", "inconclusive"]},
    "profile_sha256": {"$ref": "#/$defs/digest"},
    "boundary_id": {"const": "credential-boundary:remote-alpha"},
    "provider_id": {"const": "provider:remote-alpha"},
    "store": {"const": "os_credential_store"},
    "authentication_method": {"const": "api_key_reference"},
    "prerequisite": {"enum": ["satisfied", "failed", "unsupported", "inconclusive"]},
    "adapter_visibility": {"const": "none"},
    "secret_access": {"const": "none"},
    "ambient_configuration": {"const": "unreadable"},
    "environment_values": {"const": "unreadable"},
    "claims_established": {"type": "array", "maxItems": 0},
    "observed_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
