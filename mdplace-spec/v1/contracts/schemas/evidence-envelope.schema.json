{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:evidence-envelope:v1",
  "title": "mdplace deterministic evidence envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "envelope_id", "extension_id", "package_series", "release_version", "validator_id", "validator_version", "invocation", "requirement_id", "subject", "input_digests", "output_digests", "receipts", "artifact_digests", "execution_context", "verdict", "codes"],
  "properties": {
    "$schema": {"enum": ["../../contracts/schemas/evidence-envelope.schema.json", "../../../contracts/schemas/evidence-envelope.schema.json"]},
    "schema_id": {"const": "mdplace.evidence-envelope/v1"},
    "envelope_id": {"type": "string", "pattern": "^evidence:[a-z0-9][a-z0-9-]{2,63}$"},
    "extension_id": {"const": "mdplace.validator-extension/evidence/v1"},
    "package_series": {"const": "mdplace-spec/v1"},
    "release_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "validator_id": {"const": "mdplace.package-validator"},
    "validator_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "invocation": {"$ref": "#/$defs/invocationBinding"},
    "requirement_id": {"type": "string", "pattern": "^REQ-[A-Z][A-Z0-9]{1,15}-[0-9]{3}$"},
    "subject": {"$ref": "#/$defs/subject"},
    "input_digests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/orderedDigest"}},
    "output_digests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/orderedDigest"}},
    "receipts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/receipt"}},
    "artifact_digests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/orderedDigest"}},
    "execution_context": {"$ref": "#/$defs/executionContext"},
    "verdict": {"enum": ["pass", "fail", "unsupported", "inconclusive"]},
    "codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{1,127}$"}}
  },
  "$defs": {
    "invocationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invocation_id", "path", "sha256"],
      "properties": {
        "invocation_id": {"type": "string", "pattern": "^invocation:[a-z0-9][a-z0-9-]{2,63}$"},
        "path": {"type": "string", "pattern": "^conformance/evidence/invocations/[a-z][a-z0-9-]*\\.json$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "subject_id", "schema", "sha256"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "subject_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}:[a-z0-9][a-z0-9._-]{1,127}$"},
        "schema": {"type": "string", "pattern": "^contracts/schemas/[a-z][a-z0-9-]*\\.schema\\.json$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "orderedDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "label", "path", "sha256"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0},
        "label": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "path": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9./-]*$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "receipt_id", "receipt_type", "sha256"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0},
        "receipt_id": {"type": "string", "pattern": "^receipt:[a-z0-9][a-z0-9-]{2,63}$"},
        "receipt_type": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]{2,63}$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "executionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner_id", "platform", "architecture", "filesystem", "locale", "timezone", "network_access"],
      "properties": {
        "runner_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$"},
        "platform": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
        "architecture": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,31}$"},
        "filesystem": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"},
        "locale": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{2,63}$"},
        "timezone": {"type": "string", "pattern": "^[A-Za-z0-9_+./-]{1,63}$"},
        "network_access": {"enum": ["denied", "declared"]}
      }
    }
  }
}
