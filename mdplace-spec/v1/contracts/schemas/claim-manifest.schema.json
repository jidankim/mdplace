{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:claim-manifest:v1",
  "title": "mdplace claim-to-evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "manifest_kind", "claim_id", "profile", "package_series", "release_version", "validator_id", "validator_version", "subject", "requirement_id", "evidence_requirements", "evidence_bindings", "applicability", "verdict"],
  "properties": {
    "$schema": {"enum": ["../../contracts/schemas/claim-manifest.schema.json", "../../../contracts/schemas/claim-manifest.schema.json"]},
    "schema_id": {"const": "mdplace.claim-manifest/v1"},
    "manifest_kind": {"enum": ["conformance_example", "implementation_claim"]},
    "claim_id": {"type": "string", "pattern": "^CLAIM-[A-Z][A-Z0-9]{1,31}-[0-9]{3}$"},
    "profile": {"$ref": "#/$defs/profile"},
    "package_series": {"const": "mdplace-spec/v1"},
    "release_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "validator_id": {"const": "mdplace.package-validator"},
    "validator_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "subject": {"$ref": "#/$defs/subject"},
    "requirement_id": {"type": "string", "pattern": "^REQ-[A-Z][A-Z0-9]{1,15}-[0-9]{3}$"},
    "evidence_requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceRequirement"}},
    "evidence_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceBinding"}},
    "applicability": {"enum": ["applicable", "not_applicable", "unknown"]},
    "verdict": {"enum": ["pass", "fail", "unsupported", "inconclusive"]}
  },
  "$defs": {
    "profile": {"enum": ["core", "web_clipper_product_readiness", "local_intelligence_adapter", "remote_intelligence_adapter", "codex_intelligence_adapter", "placement_automation", "new_leaf_automatic_promotion", "alias_automatic_promotion"]},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "subject_id", "sha256"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "subject_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}:[a-z0-9][a-z0-9._-]{1,127}$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "evidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_kind", "mandatory"],
      "properties": {
        "evidence_kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "mandatory": {"type": "boolean"}
      }
    },
    "evidenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_kind", "mandatory", "availability", "applicability", "evidence_ref", "evidence_digest", "verdict"],
      "properties": {
        "evidence_kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "mandatory": {"type": "boolean"},
        "availability": {"enum": ["present", "missing", "stale", "skipped", "unsupported"]},
        "applicability": {"enum": ["applicable", "not_applicable", "unknown"]},
        "evidence_ref": {"type": ["string", "null"], "pattern": "^conformance/evidence/envelopes/[a-z][a-z0-9-]*\\.json$"},
        "evidence_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "verdict": {"enum": ["pass", "fail", "unsupported", "inconclusive"]}
      }
    }
  }
}
