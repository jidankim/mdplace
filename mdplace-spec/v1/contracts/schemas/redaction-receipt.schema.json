{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:redaction-receipt:v1",
  "title": "mdplace local redaction receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "receipt_id", "request_id", "policy_ref", "payload_sha256", "field_grant", "outcome", "issuer", "receipt_sha256"],
  "properties": {
    "$schema": {"const": "contracts/schemas/redaction-receipt.schema.json"},
    "schema_id": {"const": "mdplace.redaction-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^redaction-receipt:[a-z][a-z0-9-]{2,63}$"},
    "request_id": {"type": "string", "pattern": "^request:[a-z][a-z0-9-]{2,63}$"},
    "policy_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_id", "policy_version", "policy_sha256"],
      "properties": {
        "policy_id": {"type": "string", "pattern": "^policy:[a-z][a-z0-9-]{2,63}$"},
        "policy_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "policy_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "payload_sha256": {"$ref": "#/$defs/digest"},
    "field_grant": {
      "type": "object", "additionalProperties": false,
      "required": ["field_id", "data_class", "disclosure", "redaction_rule_id"],
      "properties": {
        "field_id": {"type": "string", "pattern": "^field:[a-z][a-z0-9_.-]{2,63}$"},
        "data_class": {"type": "string", "pattern": "^data:[a-z][a-z0-9_.-]{2,63}$"},
        "disclosure": {"enum": ["local_only", "remote"]},
        "redaction_rule_id": {"type": "string", "pattern": "^redaction:[a-z][a-z0-9-]{2,63}$"}
      }
    },
    "outcome": {"const": "applied"},
    "issuer": {"const": "mdplace_local_redactor"},
    "receipt_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
