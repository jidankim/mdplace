{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:recovery-report:v1",
  "title": "mdplace package recovery report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "fixture_id", "source_state", "source_digest", "crash_point", "operations", "receipts", "filesystem_effects", "terminal_state", "source_preserved", "verdict"],
  "properties": {
    "schema_id": {"const": "mdplace.recovery-report/v1"},
    "fixture_id": {"type": "string", "minLength": 1},
    "source_state": {"const": "released"},
    "source_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "crash_point": {"type": "string", "minLength": 1},
    "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "receipts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "filesystem_effects": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "terminal_state": {"const": "released"},
    "source_preserved": {"const": true},
    "verdict": {"const": "pass"}
  }
}
