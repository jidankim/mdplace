{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:processing-policy-scenario:v1",
  "title": "mdplace Core Processing Policy conformance scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario_id", "operation", "policy", "source_profile", "request", "descendant_policy", "approval_receipts", "redaction_receipts", "observed_binding", "compatibility_claim_ref", "lifecycle", "recovery", "lifecycle_denials", "recovery_denials"],
  "properties": {
    "scenario_id": {"type": "string", "pattern": "^CPP-[0-9]{3}$"},
    "operation": {"enum": ["processing_decision", "intake_decision", "policy_pair", "recover_binding"]},
    "policy": {"description": "Validated separately against the closed Processing Policy schema."},
    "source_profile": {"description": "Null or validated separately against the closed Source Profile schema."},
    "request": {"description": "Null or validated separately against the closed processing request schema."},
    "descendant_policy": {"description": "Null or validated separately against the closed Processing Policy schema."},
    "approval_receipts": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"description": "Validated separately against the closed approval receipt schema."}},
    "redaction_receipts": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"description": "Validated separately against the closed redaction receipt schema."}},
    "observed_binding": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/observedBinding"}]},
    "compatibility_claim_ref": {"type": ["string", "null"], "pattern": "^CLAIM-[A-Z0-9][A-Z0-9-]{2,63}$"},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "recovery": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/recovery"}]},
    "lifecycle_denials": {"type": "array", "maxItems": 22, "uniqueItems": true, "items": {"$ref": "#/$defs/lifecycleDenial"}},
    "recovery_denials": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/recoveryDenial"}}
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policyRef": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_id", "policy_version", "policy_sha256"],
      "properties": {
        "policy_id": {"type": "string", "pattern": "^policy:[a-z][a-z0-9-]{2,63}$"},
        "policy_version": {"$ref": "#/$defs/semver"},
        "policy_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "captureSource": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "claimed_source_version"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^capture-source:[a-z][a-z0-9-]{2,63}$"},
        "claimed_source_version": {"$ref": "#/$defs/semver"}
      }
    },
    "versionedArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "artifact_version", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,31}:[a-z][a-z0-9-]{2,63}$"},
        "artifact_version": {"$ref": "#/$defs/semver"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "template": {
      "type": "object", "additionalProperties": false,
      "required": ["template_id", "template_version", "import_artifact_sha256"],
      "properties": {
        "template_id": {"type": "string", "pattern": "^template:[a-z][a-z0-9-]{2,63}$"},
        "template_version": {"$ref": "#/$defs/semver"},
        "import_artifact_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "observedBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "profile_version", "profile_sha256", "vault_id", "approval_receipt_id", "approval_receipt_sha256", "approval_payload_sha256", "capture_source", "candidate_schema", "template", "url_retention_mode", "processing_policy", "capture_contract"],
      "properties": {
        "profile_id": {"type": "string", "pattern": "^source-profile:[a-z][a-z0-9-]{2,63}$"},
        "profile_version": {"$ref": "#/$defs/semver"},
        "profile_sha256": {"$ref": "#/$defs/digest"},
        "vault_id": {"type": "string", "pattern": "^vault:[a-z][a-z0-9-]{2,63}$"},
        "approval_receipt_id": {"type": "string", "pattern": "^approval:[a-z][a-z0-9-]{2,63}$"},
        "approval_receipt_sha256": {"$ref": "#/$defs/digest"},
        "approval_payload_sha256": {"$ref": "#/$defs/digest"},
        "capture_source": {"$ref": "#/$defs/captureSource"},
        "candidate_schema": {"$ref": "#/$defs/versionedArtifact"},
        "template": {"$ref": "#/$defs/template"},
        "url_retention_mode": {"enum": ["withheld", "sanitized"]},
        "processing_policy": {"$ref": "#/$defs/policyRef"},
        "capture_contract": {"$ref": "#/$defs/versionedArtifact"}
      }
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_state", "source_profile_state"],
      "properties": {
        "policy_state": {"enum": ["draft", "active", "revoked"]},
        "source_profile_state": {"enum": ["unbound", "active", "stale", "revoked", "recovery_required"]}
      }
    },
    "recovery": {
      "type": "object", "additionalProperties": false,
      "required": ["recovery_id", "crash_point", "source_profile_sha256", "approval_payload_sha256", "approval_receipt_id", "observed_binding_sha256", "trust_store_sha256", "journal_sha256"],
      "properties": {
        "recovery_id": {"type": "string", "pattern": "^recovery:[a-z][a-z0-9-]{2,63}$"},
        "crash_point": {"enum": ["before_approval_receipt_publish", "after_approval_receipt_publish", "after_binding_publish"]},
        "source_profile_sha256": {"$ref": "#/$defs/digest"},
        "approval_payload_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "approval_receipt_id": {"type": ["string", "null"], "pattern": "^approval:[a-z][a-z0-9-]{2,63}$"},
        "observed_binding_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "trust_store_sha256": {"$ref": "#/$defs/digest"},
        "journal_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "lifecycleDenial": {
      "type": "object", "additionalProperties": false,
      "required": ["table_id", "transition_id", "from_state", "command_or_event", "code", "terminal_state"],
      "properties": {
        "table_id": {"enum": ["TRANS-PROCESSING-POLICY", "TRANS-SOURCE-PROFILE"]},
        "transition_id": {"type": "string", "pattern": "^TR-(CPP|SP)-[0-9]{3}$"},
        "from_state": {"type": "string", "minLength": 1},
        "command_or_event": {"type": "string", "minLength": 1},
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"},
        "terminal_state": {"type": "string", "minLength": 1}
      }
    },
    "expectedObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["verdict", "codes", "outputs", "operations", "receipts", "filesystem_effects", "network_effects", "terminal_state", "illegal_transition"],
      "properties": {
        "verdict": {"enum": ["pass", "fail"]},
        "codes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "outputs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "operations": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "receipts": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "filesystem_effects": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "network_effects": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "terminal_state": {"type": "string"},
        "illegal_transition": {"type": "boolean"}
      }
    },
    "recoveryDenial": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "recovery", "approval_receipts", "expected"],
      "properties": {
        "case_id": {"enum": ["missing_recovery", "torn_journal", "mismatched_binding", "ambiguous_approval_receipt"]},
        "recovery": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/recovery"}]},
        "approval_receipts": {"type": "array", "maxItems": 4, "items": {"description": "Validated separately against the closed approval receipt schema."}},
        "expected": {"$ref": "#/$defs/expectedObservation"}
      }
    }
  }
}
