{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:local-adapter-isolation-evidence:v1",
  "title": "mdplace Local Intelligence Adapter isolation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "profile_id", "evidence_id", "status", "profile_sha256", "ephemeral", "fresh_process", "advisory_only", "prompt_injection_inert", "filesystem", "network", "tools", "ambient_configuration", "credentials", "semantic_writer", "observed_at", "expires_at"],
  "properties": {
    "$schema": {"const": "../schemas/local-adapter-isolation-evidence.schema.json"},
    "schema_id": {"const": "mdplace.local-adapter-isolation-evidence/v1"},
    "profile_id": {"const": "local-adapter"},
    "evidence_id": {"const": "local-isolation-evidence:v1"},
    "status": {"enum": ["current", "unsupported", "inconclusive"]},
    "profile_sha256": {"$ref": "#/$defs/digest"},
    "ephemeral": {"const": true},
    "fresh_process": {"const": true},
    "advisory_only": {"const": true},
    "prompt_injection_inert": {"const": true},
    "filesystem": {"const": "none"},
    "network": {"const": "denied"},
    "tools": {"const": "none"},
    "ambient_configuration": {"const": "unreadable"},
    "credentials": {"const": "none"},
    "semantic_writer": {"const": "unreachable"},
    "observed_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"}
  }
}
