{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:operation-receipt:v1",
  "title": "mdplace Vault Mutation Gate Operation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "receipt_id", "plan_id", "plan_sha256", "operation", "caller_id", "ownership_receipt_sha256", "source_components", "target_components", "precondition_identity", "result_identity", "journal_sha256", "idempotency_key", "echo_complete", "readback_verified", "receipt_sha256"],
  "properties": {
    "$schema": {"const": "../schemas/operation-receipt.schema.json"},
    "schema_id": {"const": "mdplace.operation-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^mutation-receipt:[a-z0-9-]{3,64}$"},
    "plan_id": {"type": "string", "pattern": "^mutation-plan:[a-z0-9-]{3,64}$"},
    "plan_sha256": {"$ref": "#/$defs/digest"},
    "operation": {"enum": ["promote_capture", "move_projection", "create_directory", "remove_empty_owned_directory", "write_managed_frontmatter"]},
    "caller_id": {"type": "string", "pattern": "^(capture-adapter|folder-projection|foreground-recovery):[a-z0-9-]{3,64}$"},
    "ownership_receipt_sha256": {"$ref": "#/$defs/digest"},
    "source_components": {"$ref": "#/$defs/components"},
    "target_components": {"$ref": "#/$defs/components"},
    "precondition_identity": {"$ref": "#/$defs/identity"},
    "result_identity": {"$ref": "#/$defs/identity"},
    "journal_sha256": {"$ref": "#/$defs/digest"},
    "idempotency_key": {"type": "string", "pattern": "^vmg-idem:[a-z0-9-]{3,64}$"},
    "echo_complete": {"const": true},
    "readback_verified": {"const": true},
    "receipt_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "components": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]{1,255}$"}},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["device", "inode", "size", "content_sha256"],
      "properties": {"device": {"type": "integer", "minimum": 0}, "inode": {"type": "integer", "minimum": 1}, "size": {"type": "integer", "minimum": 0}, "content_sha256": {"$ref": "#/$defs/digest"}}
    }
  }
}
