{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:evidence-transition-attempt:v1",
  "title": "mdplace evidence lifecycle transition attempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "package_series", "release_version", "validator_id", "validator_version", "table_ref", "from_state", "command", "actor_authority", "fresh_evidence_supplied", "recorded_claim", "recovery_report", "fresh_claim"],
  "properties": {
    "$schema": {"enum": ["../../contracts/schemas/evidence-transition-attempt.schema.json", "../../../contracts/schemas/evidence-transition-attempt.schema.json"]},
    "schema_id": {"const": "mdplace.evidence-transition-attempt/v1"},
    "package_series": {"const": "mdplace-spec/v1"},
    "release_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "validator_id": {"const": "mdplace.package-validator"},
    "validator_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "table_ref": {"const": "contracts/transitions/evidence-lifecycle.json"},
    "from_state": {"enum": ["awaiting_evidence", "verdict_recorded", "evidence_stale"]},
    "command": {"enum": ["record_verdict", "readback", "mark_stale", "supply_fresh_evidence"]},
    "actor_authority": {"$ref": "#/$defs/authority"},
    "fresh_evidence_supplied": {"type": "boolean"},
    "recorded_claim": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/claimBinding"}
      ]
    },
    "recovery_report": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/recoveryBinding"}
      ]
    },
    "fresh_claim": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/claimBinding"}
      ]
    }
  },
  "$defs": {
    "claimBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "path", "sha256"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^CLAIM-[A-Z][A-Z0-9]{1,31}-[0-9]{3}$"},
        "path": {"type": "string", "pattern": "^conformance/(?:claim-manifests|evidence/claims)/[a-z][a-z0-9-]*\\.json$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "recoveryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_id", "path", "sha256"],
      "properties": {
        "report_id": {"type": "string", "pattern": "^evidence-recovery:[a-z0-9][a-z0-9-]{2,63}$"},
        "path": {"type": "string", "pattern": "^conformance/evidence/[a-z][a-z0-9-]*\\.json$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles", "quorum", "distinct_actors", "delegation"],
      "properties": {
        "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["conformance_validator", "evidence_supplier"]}},
        "quorum": {"const": 1},
        "distinct_actors": {"const": false},
        "delegation": {"enum": ["forbidden", "permitted"]}
      }
    }
  }
}
