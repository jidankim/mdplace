{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdplace:schema:intelligence-adapter-approved-context:v1",
  "title": "mdplace trusted Intelligence Adapter authorization context",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "context_id", "vault_id", "policy_binding", "source_profile_binding", "taxonomy_revision_binding", "contracts", "attempt_authorizations", "chain_budget"],
  "properties": {
    "$schema": {"const": "../schemas/intelligence-adapter-approved-context.schema.json"},
    "schema_id": {"const": "mdplace.intelligence-adapter-approved-context/v1"},
    "context_id": {"type": "string", "pattern": "^adapter-context:[a-z0-9-]{3,64}$"},
    "vault_id": {"type": "string", "pattern": "^vault:[a-z0-9-]{3,64}$"},
    "policy_binding": {"$ref": "#/$defs/policyBinding"},
    "source_profile_binding": {"$ref": "#/$defs/sourceProfileBinding"},
    "taxonomy_revision_binding": {"$ref": "#/$defs/taxonomyRevisionBinding"},
    "contracts": {"$ref": "#/$defs/contracts"},
    "attempt_authorizations": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/attemptAuthorization"}},
    "chain_budget": {"$ref": "#/$defs/chainBudget"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stringSet": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "policyBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_id", "policy_version", "policy_sha256", "lifecycle_state", "approved"],
      "properties": {
        "policy_id": {"type": "string", "pattern": "^policy:[a-z0-9-]{3,64}$"},
        "policy_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "policy_sha256": {"$ref": "#/$defs/digest"},
        "lifecycle_state": {"const": "active"},
        "approved": {"const": true}
      }
    },
    "sourceProfileBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "profile_version", "profile_sha256", "lifecycle_state", "approved"],
      "properties": {
        "profile_id": {"type": "string", "pattern": "^(profile|source-profile):[a-z0-9-]{3,64}$"},
        "profile_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "profile_sha256": {"$ref": "#/$defs/digest"},
        "lifecycle_state": {"const": "active"},
        "approved": {"const": true}
      }
    },
    "taxonomyRevisionBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["revision_id", "revision", "sha256"],
      "properties": {
        "revision_id": {"type": "string", "pattern": "^taxonomy-revision:[a-z0-9-]{3,64}$"},
        "revision": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "contracts": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter_contract_version", "prompt_contract_version", "proposal_schema_id", "proposal_schema_version"],
      "properties": {
        "adapter_contract_version": {"const": "1.0.0"},
        "prompt_contract_version": {"const": "1.0.0"},
        "proposal_schema_id": {"const": "mdplace.intelligence-proposal/v1"},
        "proposal_schema_version": {"const": "1.0.0"}
      }
    },
    "destination": {
      "type": "object", "additionalProperties": false,
      "required": ["destination_id", "endpoint", "locality"],
      "properties": {
        "destination_id": {"type": "string", "pattern": "^destination:[a-z0-9-]{3,64}$"},
        "endpoint": {"type": "string", "minLength": 1},
        "locality": {"enum": ["local", "remote"]}
      }
    },
    "redaction": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "receipt_sha256"],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^redaction:[a-z0-9-]{3,64}$"},
        "receipt_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "retention": {
      "type": "object", "additionalProperties": false,
      "required": ["retention_fact_id", "status", "max_days", "data_use", "region", "subprocessors"],
      "properties": {
        "retention_fact_id": {"type": "string", "pattern": "^retention:[a-z0-9-]{3,64}$"},
        "status": {"enum": ["known", "unknown_acknowledged"]},
        "max_days": {"type": "integer", "minimum": 0, "maximum": 36500},
        "data_use": {"enum": ["request_only", "provider_training_unknown"]},
        "region": {"type": "string", "minLength": 1},
        "subprocessors": {"$ref": "#/$defs/stringSet"}
      }
    },
    "credentialBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["credential_ref", "store", "authentication_method", "provider_id", "purpose_id", "adapter_visibility"],
      "properties": {
        "credential_ref": {"type": "string", "pattern": "^credential-ref:[a-z0-9-]{3,64}$"},
        "store": {"const": "os_credential_store"},
        "authentication_method": {"enum": ["api_key", "local_process"]},
        "provider_id": {"type": "string", "pattern": "^provider:[a-z0-9-]{3,64}$"},
        "purpose_id": {"type": "string", "pattern": "^purpose:[a-z0-9-]{3,64}$"},
        "adapter_visibility": {"const": "none"}
      }
    },
    "ceilings": {
      "type": "object", "additionalProperties": false,
      "required": ["input_bytes", "output_bytes", "runtime_ms", "cost_microunits"],
      "properties": {
        "input_bytes": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "output_bytes": {"type": "integer", "minimum": 1, "maximum": 100000},
        "runtime_ms": {"type": "integer", "minimum": 1, "maximum": 120000},
        "cost_microunits": {"type": "integer", "minimum": 0, "maximum": 10000000}
      }
    },
    "attemptAuthorization": {
      "type": "object", "additionalProperties": false,
      "required": ["authorization_id", "attempt_class", "position", "adapter_id", "provider_id", "model_id", "model_version", "purpose_id", "destination", "field_ids", "artifact_kinds", "redactions", "capabilities", "retention_facts", "retention_artifacts", "credential_boundary", "ceilings"],
      "properties": {
        "authorization_id": {"type": "string", "pattern": "^adapter-authorization:[a-z0-9-]{3,64}$"},
        "attempt_class": {"enum": ["primary", "retry", "fallback"]},
        "position": {"type": "integer", "minimum": 0, "maximum": 2},
        "adapter_id": {"type": "string", "pattern": "^adapter:[a-z0-9-]{3,64}$"},
        "provider_id": {"type": "string", "pattern": "^provider:[a-z0-9-]{3,64}$"},
        "model_id": {"type": "string", "pattern": "^model:[a-z0-9.-]{3,64}$"},
        "model_version": {"type": "string", "minLength": 1},
        "purpose_id": {"type": "string", "pattern": "^purpose:[a-z0-9-]{3,64}$"},
        "destination": {"$ref": "#/$defs/destination"},
        "field_ids": {"$ref": "#/$defs/stringSet"},
        "artifact_kinds": {"$ref": "#/$defs/stringSet"},
        "redactions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/redaction"}},
        "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["capability:produce-proposal", "capability:fixed-destination-network"]}},
        "retention_facts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/retention"}},
        "retention_artifacts": {"$ref": "#/$defs/stringSet"},
        "credential_boundary": {"$ref": "#/$defs/credentialBoundary"},
        "ceilings": {"$ref": "#/$defs/ceilings"}
      }
    },
    "chainBudget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_attempts", "max_retries", "max_fallbacks", "input_bytes", "output_bytes", "runtime_ms", "cost_microunits"],
      "properties": {
        "max_attempts": {"const": 3}, "max_retries": {"const": 1}, "max_fallbacks": {"const": 1},
        "input_bytes": {"type": "integer", "minimum": 1}, "output_bytes": {"type": "integer", "minimum": 1},
        "runtime_ms": {"type": "integer", "minimum": 1}, "cost_microunits": {"type": "integer", "minimum": 0}
      }
    }
  }
}
